MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;Database=vocanova;User=root;Password=YOUR_MYSQL_PASSWORD;
MYSQL_SERVER_VERSION=8.0.0-mysql

# ASP.NET configuration override keys use double underscore (__).
# Keep local values in .env; appsettings.json intentionally contains no secrets/local config.

JwtSettings__Issuer=VocaNova
JwtSettings__Audience=VocaNova.Clients
JwtSettings__SecretKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=30

Redis__Configuration=localhost:6379
Redis__InstanceName=vocanova:

# The AI grading block is editable from /settings in the dashboard, which rewrites these lines
# in place. Keep any hand-written comments above the block, not between its entries.
AiGrading__Provider=Gemini
AiGrading__Endpoint=https://generativelanguage.googleapis.com/v1beta
AiGrading__ApiKey=
AiGrading__Model=gemini-3.1-flash-lite
AiGrading__FallbackModels__0=gemini-3.5-flash
AiGrading__MaxAttempts=2
AiGrading__RetryBaseDelayMs=400
AiGrading__AttemptTimeoutSeconds=6
AiGrading__PassThreshold=0.75

# Profile-vector weights: editable from /knn in the dashboard, which rewrites these lines.
Knn__Vector__AgeRangeWeight=1.0
Knn__Vector__RegionWeight=0.6
Knn__Vector__OccupationWeight=1.0
Knn__Vector__EducationLevelWeight=0.8
Knn__Vector__LearningPurposeWeight=1.5
Knn__Vector__InterestTopicsWeight=2.0

Knn__Onboarding__KValue=5
Knn__Onboarding__DefaultTopicLimit=10
Knn__Onboarding__MinSimilarity=0.1
Knn__Onboarding__CacheTtlMinutes=30
Knn__Learning__KValue=5
Knn__Learning__MinSessions=5
Knn__Learning__MinSimilarity=0.1
Knn__Learning__RecommendationCount=50
Knn__Learning__RebuildIntervalHours=24
Knn__Learning__CacheTtlMinutes=60

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=vocanova/words
Cloudinary__AvatarFolder=vocanova/avatars
Cloudinary__AudioFolder=vocanova/words/audio

RateLimit__OtpPerMinutePerPhone=1
RateLimit__OtpPerMinutePerIp=1

# SpeedSMS Android Gateway. Keep AccessToken and DeviceId in the local .env only.
SpeedSms__Enabled=false
SpeedSms__AccessToken=
SpeedSms__DeviceId=
SpeedSms__SmsType=5
SpeedSms__BaseUrl=https://api.speedsms.vn/index.php/
RateLimit__LoginPerMinutePerIp=10
RateLimit__RetryAfterSeconds=60
