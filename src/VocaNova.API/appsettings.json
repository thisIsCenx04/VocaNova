{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vocanova;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "VocaNova",
    "Audience": "VocaNova.Clients",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "vocanova:"
  },
  "AiGrading": {
    "Provider": "OpenAI",
    "Endpoint": "",
    "ApiKey": "",
    "Model": "",
    "PassThreshold": 0.75
  },
  "RateLimit": {
    "OtpPerMinutePerPhone": 1,
    "OtpPerMinutePerIp": 1,
    "LoginPerMinutePerIp": 10,
    "RetryAfterSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
