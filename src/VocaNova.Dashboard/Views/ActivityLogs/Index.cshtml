@model VocaNova.Dashboard.Models.Activity.ActivityLogViewModel
@using VocaNova.Dashboard.Models.Components
@{
    ViewData["Title"] = L["Nav.ActivityLogs"];
    string PageUrl(int p) => Url.Action("Index", new { userId = Model.Query.UserId, entity = Model.Query.Entity, page = p, limit = Model.Query.Limit }) ?? "#";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@L["Activity.Eyebrow"]</p>
        <h1>@L["Nav.ActivityLogs"]</h1>
    </div>
</div>

<form class="filter-bar" method="get" asp-controller="ActivityLogs" asp-action="Index">
    <input class="form-control" type="number" min="1" name="userId" value="@(Model.Query.UserId?.ToString())" placeholder="@L["Activity.Filter.UserId"]" />
    <input class="form-control" type="search" name="entity" value="@Model.Query.Entity" placeholder="@L["Activity.Filter.Entity"]" />
    <button class="btn btn-primary" type="submit">@L["Common.Apply"]</button>
</form>

@if (!Model.Loaded)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
}
else if (Model.Logs.Count == 0)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Empty, Title = L["Activity.Empty.Title"].Value, Message = L["Activity.Empty.Msg"].Value })" />
}
else
{
    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L["Activity.Col.Time"]</th>
                    <th>@L["Activity.Col.User"]</th>
                    <th>@L["Activity.Col.Action"]</th>
                    <th>@L["Activity.Col.Entity"]</th>
                    <th>@L["Activity.Col.EntityId"]</th>
                    <th>@L["Activity.Col.Ip"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="mono">@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><a class="mono" href="/users/@log.UserId">#@log.UserId</a></td>
                        <td><strong>@log.Action</strong></td>
                        <td><span class="mono">@log.EntityType</span></td>
                        <td class="mono" style="color: var(--muted);">@(log.EntityId?.ToString() ?? "—")</td>
                        <td class="mono" style="color: var(--muted);">@(string.IsNullOrWhiteSpace(log.IpAddress) ? "—" : log.IpAddress)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="Components/_Pagination" model="@(new PaginationViewModel { Page = Model.Pagination?.Page ?? 1, TotalPages = Model.Pagination?.TotalPages ?? 1, TotalItems = Model.Pagination?.TotalItems ?? Model.Logs.Count, PageUrl = PageUrl })" />
}
