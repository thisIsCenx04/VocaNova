@using VocaNova.Dashboard.Models.Api.Users
@model VocaNova.Dashboard.Models.Users.UserListViewModel
@{
    ViewData["Title"] = "User Management";
    var pageStart = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.Limit + 1;
    var pageEnd = pageStart == 0 ? 0 : pageStart + Model.Items.Count - 1;

    string PageUrl(int page)
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Search)) qs.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) qs.Add($"status={Model.Status}");
        if (!string.IsNullOrWhiteSpace(Model.Role)) qs.Add($"role={Model.Role}");
        if (Model.IncludeDeleted) qs.Add("includeDeleted=true");
        qs.Add($"page={page}");
        return "/users?" + string.Join("&", qs);
    }

    string StatusBadge(string status) => status switch
    {
        "active" => "badge badge-success",
        "locked" => "badge badge-warning",
        "deleted" => "badge badge-danger",
        _ => "badge badge-muted",
    };
}

<div class="page-header">
    <h1 class="page-title">User Management</h1>
    <p class="page-subtitle">Manage learners and admin accounts.</p>
</div>

@if (TempData["UserSuccess"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["UserError"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<form method="get" action="/users" class="filter-bar">
    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email or phone..." />
    <select name="status" class="form-control">
        <option value="">All status</option>
        @foreach (var s in VocaNova.Dashboard.Models.Users.UserListViewModel.Statuses)
        {
            <option value="@s" selected="@(Model.Status == s)">@s</option>
        }
    </select>
    <select name="role" class="form-control">
        <option value="">All roles</option>
        @foreach (var (value, label) in VocaNova.Dashboard.Models.Users.UserListViewModel.Roles)
        {
            <option value="@value" selected="@(Model.Role == value)">@label</option>
        }
    </select>
    <label class="checkbox-inline">
        <input type="checkbox" name="includeDeleted" value="true" checked="@Model.IncludeDeleted" />
        Show deleted
    </label>
    <button type="submit" class="btn-primary">Filter</button>
    <a href="/users" class="btn-secondary">Reset</a>
</form>

<div class="panel table-panel">
    <table class="data-table">
        <thead>
            <tr>
                <th style="width:70px;">User ID</th>
                <th>Name</th>
                <th>Email</th>
                <th style="width:110px;">Status</th>
                <th style="width:140px;">Phone</th>
                <th style="width:80px;" class="col-actions">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="empty-row">No users found.</td></tr>
            }
            else
            {
                foreach (var user in Model.Items)
                {
                    <tr>
                        <td><span class="rank-pill">#@user.UserId</span></td>
                        <td>
                            <div class="user-cell">
                                @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                {
                                    <img class="user-avatar" src="@user.AvatarUrl" alt="" />
                                }
                                else
                                {
                                    <span class="user-avatar user-avatar-fallback">@(string.IsNullOrWhiteSpace(user.DisplayName) ? "?" : user.DisplayName[..1].ToUpperInvariant())</span>
                                }
                                <div class="user-cell-text">
                                    <span class="word-text">@user.DisplayName</span>
                                    <span class="user-role-sub">@user.Role.Replace("_", " ")</span>
                                </div>
                            </div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(user.GoogleEmail) ? "—" : user.GoogleEmail)</td>
                        <td><span class="@StatusBadge(user.Status)">@user.Status</span></td>
                        <td>@(user.Phone ?? "—")</td>
                        <td class="col-actions">
                            <div class="action-icons">
                                <a class="icon-link" href="/users/@user.UserId" title="View details" aria-label="View details">
                                    <svg viewBox="0 0 24 24"><path d="M12 5c-5 0-8.5 4.5-9.5 7 1 2.5 4.5 7 9.5 7s8.5-4.5 9.5-7c-1-2.5-4.5-7-9.5-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                                </a>
                                @if (user.Status == "active")
                                {
                                    <button type="button" class="icon-link warn js-disable"
                                            data-id="@user.UserId" data-name="@user.DisplayName"
                                            title="Disable account" aria-label="Disable account">
                                        <svg viewBox="0 0 24 24"><path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm-3 8V6a3 3 0 0 1 6 0v3H9Zm3 4a1.5 1.5 0 0 1 1 2.6V19h-2v-3.4A1.5 1.5 0 0 1 12 13Z"/></svg>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="icon-link ok js-restore"
                                            data-id="@user.UserId" data-name="@user.DisplayName"
                                            title="Enable account" aria-label="Enable account">
                                        <svg viewBox="0 0 24 24"><path d="M12 1a5 5 0 0 0-5 5h2a3 3 0 0 1 6 0v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Z"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-foot-bar">
    <span class="pager-info">Showing @pageStart to @pageEnd of @Model.TotalItems entries</span>
    @if (Model.TotalPages > 1)
    {
        var winStart = Model.Page;
        var winEnd = Math.Min(Model.Page + 2, Model.TotalPages);
        <nav class="pager" aria-label="Pagination">
            @if (Model.HasPrevious)
            {
                <a class="pager-link" href="@PageUrl(Model.Page - 1)">‹ Prev</a>
            }
            else
            {
                <span class="pager-link disabled">‹ Prev</span>
            }
            @for (var p = winStart; p <= winEnd; p++)
            {
                <a class="pager-link @(p == Model.Page ? "active" : "")" href="@PageUrl(p)">@p</a>
            }
            @if (Model.HasNext)
            {
                <a class="pager-link" href="@PageUrl(Model.Page + 1)">Next ›</a>
            }
            else
            {
                <span class="pager-link disabled">Next ›</span>
            }
        </nav>
    }
</div>

<div class="modal-overlay" id="user-modal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="um-title">
        <div class="modal-icon" id="um-icon"><svg viewBox="0 0 24 24"><path d="M12 2 1 21h22L12 2Zm-1 6h2v7h-2V8Zm0 9h2v2h-2v-2Z"/></svg></div>
        <h3 class="modal-title" id="um-title">Disable user account</h3>
        <p class="modal-text" id="um-text"></p>
        <div class="modal-actions">
            <button type="button" class="btn-secondary" data-close-modal>Cancel</button>
            <form method="post" id="um-form" class="inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-warning" id="um-confirm">Disable</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/users-list.js" asp-append-version="true"></script>
}
