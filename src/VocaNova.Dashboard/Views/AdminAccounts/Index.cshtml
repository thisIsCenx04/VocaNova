@model VocaNova.Dashboard.Models.AdminAccounts.AdminAccountListViewModel
@using VocaNova.Dashboard.Models.Components
@{
    ViewData["Title"] = L["Nav.AdminAccounts"];
    string PageUrl(int p) => Url.Action("Index", new { q = Model.Query.Q, page = p, limit = Model.Query.Limit }) ?? "#";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@L["AdminAcc.Eyebrow"]</p>
        <h1>@L["Nav.AdminAccounts"]</h1>
    </div>
    @if (Model.ApiAvailable)
    {
        <button type="button" class="btn btn-primary" data-form-url="/admin-accounts/create" data-form-title="@L["AdminAcc.New"]">
            @L["AdminAcc.New"]
        </button>
    }
    else
    {
        <button type="button" class="btn btn-primary" disabled title="@L["Common.ComingSoon"]">@L["AdminAcc.New"]</button>
    }
</div>

@if (!Model.ApiAvailable)
{
    @* G9 chưa deploy → khung "Sắp có", tự sáng đèn khi An thêm endpoint. *@
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Empty, Title = L["AdminAcc.Skeleton.Title"].Value, Message = L["AdminAcc.Skeleton.Msg"].Value })" />
}
else if (!Model.Loaded)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
}
else
{
    <form class="filter-bar" method="get" asp-controller="AdminAccounts" asp-action="Index">
        <input class="form-control" type="search" name="q" value="@Model.Query.Q" placeholder="@L["Common.Search"]" />
        <button class="btn btn-primary" type="submit">@L["Common.Apply"]</button>
    </form>

    @if (Model.Accounts.Count == 0)
    {
        <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Empty, Title = L["AdminAcc.Empty.Title"].Value, Message = L["AdminAcc.Empty.Msg"].Value })" />
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L["AdminAcc.Col.Name"]</th>
                        <th>@L["AdminAcc.Col.Phone"]</th>
                        <th>@L["AdminAcc.Col.Role"]</th>
                        <th>@L["Tbl.Status"]</th>
                        <th>@L["AdminAcc.Col.Created"]</th>
                        <th>@L["Tbl.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr>
                            <td><strong>@a.DisplayName</strong></td>
                            <td><span class="mono">@(string.IsNullOrWhiteSpace(a.Phone) ? "—" : a.Phone)</span></td>
                            <td><partial name="Components/_Badge" model="@(new BadgeViewModel { Text = a.Role.Replace("_", " "), Modifier = a.Role == "super_admin" ? "info" : "ok" })" /></td>
                            <td><partial name="Components/_Badge" model="@(new BadgeViewModel { Text = L["User.Status." + a.Status].Value, Modifier = BadgeModifiers.Status(a.Status) })" /></td>
                            <td class="mono" style="color: var(--muted);">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn btn-sm btn-secondary"
                                            data-form-url="/admin-accounts/@a.UserId/edit"
                                            data-form-title="@L["Common.Edit"]">@L["Common.Edit"]</button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            data-confirm-url="/admin-accounts/@a.UserId/delete"
                                            data-confirm-message="@L["AdminAcc.Delete.Confirm"]"
                                            data-confirm-variant="danger"
                                            data-confirm-ok="@L["Common.Delete"]">@L["Common.Delete"]</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Components/_Pagination" model="@(new PaginationViewModel { Page = Model.Pagination?.Page ?? 1, TotalPages = Model.Pagination?.TotalPages ?? 1, TotalItems = Model.Pagination?.TotalItems ?? Model.Accounts.Count, PageUrl = PageUrl })" />
    }
}
