@model ResetPasswordViewModel
@{
    ViewData["Title"] = T["Reset password"];
}

<div class="auth-card">
    <aside class="auth-welcome" aria-hidden="true">
        <div class="auth-welcome-content">
            <h2>@T["Create a new password."]</h2>
            <p>@T["Use the OTP from your phone and choose a strong password for dashboard access."]</p>
        </div>
        <div class="auth-welcome-art">
            <span class="auth-art-card auth-art-card-main"><i class="bi bi-key-fill"></i></span>
            <span class="auth-art-card auth-art-card-small"><i class="bi bi-check2-circle"></i></span>
            <span class="auth-art-dot auth-art-dot-one"></span>
            <span class="auth-art-dot auth-art-dot-two"></span>
        </div>
    </aside>

    <section class="auth-form-panel">
        <img class="auth-logo" src="~/img/logo.png" alt="VocaNova" />

        <div class="auth-heading">
            <h1 class="auth-title">@T["Reset password"]</h1>
            <p class="auth-subtitle">@T["Enter the OTP and your new password."]</p>
        </div>

        @if (TempData["AuthSuccess"] is string okMsg)
        {
            <div class="alert alert-success">@T[okMsg]</div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <div class="form-group auth-form-group">
                <label asp-for="Phone">@T["Phone"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-telephone auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="Phone" class="form-control auth-input" autocomplete="username" inputmode="tel"
                           data-val-required="@T["Phone is required."]" autofocus />
                </div>
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>

            <div class="form-group auth-form-group">
                <label asp-for="OtpCode">@T["OTP code"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-chat-left-dots auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="OtpCode" class="form-control auth-input" autocomplete="one-time-code" inputmode="numeric"
                           maxlength="6" data-val-required="@T["OTP code is required."]" />
                </div>
                <span asp-validation-for="OtpCode" class="field-error"></span>
            </div>

            <div class="form-group auth-form-group">
                <label asp-for="NewPassword">@T["New password"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="NewPassword" class="form-control auth-input auth-password-input" autocomplete="new-password"
                           data-val-required="@T["Password is required."]" type="password" />
                    <button class="auth-password-toggle" type="button" aria-label="@T["Show password"]" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-group auth-form-group">
                <label asp-for="ConfirmPassword">@T["Confirm password"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock-fill auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="ConfirmPassword" class="form-control auth-input auth-password-input" autocomplete="new-password"
                           data-val-required="@T["Confirm password is required."]" type="password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary btn-block auth-submit">
                <span>@T["Reset password"]</span>
            </button>

            <p class="auth-link-row">
                <a asp-controller="Auth" asp-action="ForgotPassword">@T["Request a new OTP"]</a>
                <span aria-hidden="true">·</span>
                <a asp-controller="Auth" asp-action="Login">@T["Back to sign in"]</a>
            </p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll('.auth-password-toggle').forEach((toggle) => {
                const wrap = toggle.closest('.auth-input-wrap');
                const input = wrap?.querySelector('.auth-password-input');
                if (!input) return;

                toggle.addEventListener('click', () => {
                    const showPassword = input.type === 'password';
                    input.type = showPassword ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', showPassword.toString());
                    toggle.setAttribute('aria-label', showPassword ? '@T["Hide password"]' : '@T["Show password"]');
                    toggle.querySelector('i')?.classList.toggle('bi-eye', !showPassword);
                    toggle.querySelector('i')?.classList.toggle('bi-eye-slash', showPassword);
                    input.focus();
                });
            });
        })();
    </script>
}
