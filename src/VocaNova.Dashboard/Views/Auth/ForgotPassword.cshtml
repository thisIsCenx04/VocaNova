@model ForgotPasswordViewModel
@{
    ViewData["Title"] = T["Forgot password"];
}

<div class="auth-card">
    <aside class="auth-welcome" aria-hidden="true">
        <div class="auth-welcome-content">
            <h2>@T["Reset access safely."]</h2>
            <p>@T["Enter the administrator phone number and VocaNova will send a reset OTP."]</p>
        </div>
        <div class="auth-welcome-art">
            <span class="auth-art-card auth-art-card-main"><i class="bi bi-shield-lock-fill"></i></span>
            <span class="auth-art-card auth-art-card-small"><i class="bi bi-phone-fill"></i></span>
            <span class="auth-art-dot auth-art-dot-one"></span>
            <span class="auth-art-dot auth-art-dot-two"></span>
        </div>
    </aside>

    <section class="auth-form-panel">
        <img class="auth-logo" src="~/img/logo.png" alt="VocaNova" />

        <div class="auth-heading">
            <h1 class="auth-title">@T["Forgot password"]</h1>
            <p class="auth-subtitle">@T["We will send an OTP to the phone number linked to your admin account."]</p>
        </div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <div class="form-group auth-form-group">
                <label asp-for="Phone">@T["Phone"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-telephone auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="Phone" class="form-control auth-input" autocomplete="username" inputmode="tel"
                           data-val-required="@T["Phone is required."]" autofocus />
                </div>
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary btn-block auth-submit">
                <span>@T["Send reset OTP"]</span>
            </button>

            <p class="auth-link-row">
                <a asp-controller="Auth" asp-action="Login">@T["Back to sign in"]</a>
            </p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
