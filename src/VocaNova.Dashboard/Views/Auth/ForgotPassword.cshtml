@model VocaNova.Dashboard.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = L["Forgot.Title"];
    var isReset = Model.Step == "reset";
}

<section class="login-panel" aria-labelledby="forgot-title">
    <div class="login-brand">
        <span class="brand-mark">VN</span>
        <div>
            <h1 id="forgot-title">@L["Forgot.Title"]</h1>
            <p>@(isReset ? L["Forgot.Subtitle.Reset"] : L["Forgot.Subtitle.Request"])</p>
        </div>
    </div>

    <ol class="auth-steps" aria-label="@L["Forgot.Title"]">
        <li class="@(isReset ? "is-complete" : "is-active")"><span>1</span>@L["Forgot.Step.Request"]</li>
        <li class="@(isReset ? "is-active" : null)"><span>2</span>@L["Forgot.Step.Reset"]</li>
    </ol>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    @if (!string.IsNullOrEmpty(Model.Info))
    {
        <div class="auth-info small mb-2">@Model.Info</div>
    }

    @if (!isReset)
    {
        <form asp-action="RequestReset" asp-controller="Auth" method="post" class="login-form">
            @Html.AntiForgeryToken()
            <div class="form-field">
                <label asp-for="Phone">@L["Forgot.Field.Phone"]</label>
                <input asp-for="Phone" class="form-control" autocomplete="tel" inputmode="tel" autofocus />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["Forgot.SendCode"]</button>
        </form>
    }
    else
    {
        <form asp-action="ConfirmReset" asp-controller="Auth" method="post" class="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Phone" />
            <input type="hidden" asp-for="Step" />

            <div class="form-field">
                <label asp-for="OtpCode">@L["Forgot.Field.Otp"]</label>
                <input asp-for="OtpCode" class="form-control mono" inputmode="numeric" maxlength="6" autocomplete="one-time-code" autofocus />
                <span asp-validation-for="OtpCode" class="text-danger small"></span>
                @if (Model.ExpiresIn > 0)
                {
                    <small style="color: var(--muted);">@L["Forgot.OtpExpiry", Model.ExpiresIn / 60]</small>
                }
            </div>
            <div class="form-field">
                <label asp-for="NewPassword">@L["Forgot.Field.NewPassword"]</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <small style="color: var(--muted);">@L["Forgot.PasswordHint"]</small>
            </div>
            <div class="form-field">
                <label asp-for="ConfirmPassword">@L["Forgot.Field.ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["Forgot.ResetPassword"]</button>
        </form>
    }

    <p class="auth-back">
        <a href="/login">@L["Forgot.BackToLogin"]</a>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
