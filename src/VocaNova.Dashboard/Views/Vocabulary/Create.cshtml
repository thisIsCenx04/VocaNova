@{
    ViewData["Title"] = "Create New Vocabulary";
}

<div class="page-header">
    <a class="back-link" href="/vocabulary">‹ Back to vocabulary</a>
    <h1 class="page-title">Create New Vocabulary</h1>
    <p class="page-subtitle">Add the word metadata. Senses, examples, audio and image are managed on the detail page.</p>
</div>

@if (TempData["VocabError"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<div class="panel create-panel">
    <form method="post" action="/vocabulary/create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="word">Word <span class="req">*</span></label>
            <input id="word" name="Word" class="form-control" placeholder="e.g. resilient" required autofocus />
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label for="cefr">CEFR level</label>
                <select id="cefr" name="Cefr" class="form-control">
                    <option value="">— none —</option>
                    @foreach (var level in VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel.CefrLevels)
                    {
                        <option value="@level">@level</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="checkbox-inline" style="margin-top:30px;">
                    <input type="checkbox" name="IsPhrase" value="true" />
                    This is a phrase / idiom
                </label>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label for="puk">Phonetic (UK)</label>
                <input id="puk" name="PhoneticUk" class="form-control" placeholder="/rɪˈzɪl.i.ənt/" />
            </div>
            <div class="form-group">
                <label for="pus">Phonetic (US)</label>
                <input id="pus" name="PhoneticUs" class="form-control" placeholder="/rɪˈzɪl.jənt/" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create vocabulary</button>
            <a href="/vocabulary" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
