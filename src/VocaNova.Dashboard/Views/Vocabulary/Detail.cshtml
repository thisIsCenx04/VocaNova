@model VocaNova.Dashboard.Models.Vocabulary.VocabularyDetailViewModel
@using VocaNova.Dashboard.Models.Components
@{
    ViewData["Title"] = Model.Word is null ? L["Vocab.Detail.Title"].Value : Model.Word.Word;
}

<div class="detail-breadcrumb">
    <a href="/vocabulary">@L["Vocab.Eyebrow"]</a>
    <span aria-hidden="true">/</span>
    <span>@L["Vocab.Detail.Title"]</span>
</div>

@if (!Model.Loaded || Model.Word is null)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel
    {
        State = BlockState.Error,
        Title = L["Vocab.Detail.LoadError.Title"].Value,
        Message = string.IsNullOrWhiteSpace(Model.ErrorMessage) ? L["State.LoadError"].Value : Model.ErrorMessage,
        ActionText = L["Common.Back"].Value,
        ActionUrl = "/vocabulary"
    })" />
    return;
}

@{
    var word = Model.Word;
    var allRelations = word.Relations
        .Concat(word.Senses.SelectMany(sense => sense.Relations))
        .GroupBy(relation => relation.RelationId)
        .Select(group => group.First())
        .OrderBy(relation => relation.RelationType)
        .ThenBy(relation => relation.RelatedWord)
        .ToList();
}

<div class="page-header detail-page-header">
    <div>
        <span class="eyebrow">@L["Vocab.Detail.Eyebrow"]</span>
        <h1>@L["Vocab.Detail.Title"]</h1>
        <p>@L["Vocab.Detail.Subtitle"]</p>
    </div>
    <a class="btn btn-secondary" href="/vocabulary">@L["Common.Back"]</a>
</div>

<section class="word-hero" aria-labelledby="word-title">
    <div class="word-hero__image">
        @if (!string.IsNullOrWhiteSpace(word.ImageUrl))
        {
            <img src="@word.ImageUrl" alt="@word.Word" />
        }
        else
        {
            <span aria-hidden="true">@(string.IsNullOrWhiteSpace(word.Word) ? "V" : word.Word[..1].ToUpperInvariant())</span>
        }
    </div>
    <div class="word-hero__content">
        <div class="word-hero__title-row">
            <div>
                <span class="word-kicker">@(word.IsPhrase ? L["Vocab.Detail.Phrase"] : L["Vocab.Detail.Word"])</span>
                <h2 id="word-title">@word.Word</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(word.Cefr))
            {
                <partial name="Components/_Badge" model="@(new BadgeViewModel { Text = $"CEFR {word.Cefr}", Modifier = BadgeModifiers.Cefr(word.Cefr) })" />
            }
        </div>

        <div class="pronunciation-strip">
            @foreach (var accent in new[] { "uk", "us" })
            {
                var phonetic = accent == "uk" ? word.PhoneticUk : word.PhoneticUs;
                var audio = word.Audio.FirstOrDefault(item => string.Equals(item.Accent, accent, StringComparison.OrdinalIgnoreCase));
                <div class="pronunciation-chip">
                    <strong>@accent.ToUpperInvariant()</strong>
                    <span>@(string.IsNullOrWhiteSpace(phonetic) ? L["Common.NotAvailable"] : phonetic)</span>
                    @if (audio is not null)
                    {
                        <button type="button" class="audio-play-button" data-audio-target="audio-@audio.AudioId" aria-label="@L["Audio.Play", accent.ToUpperInvariant()]">▶</button>
                        <audio id="audio-@audio.AudioId" preload="none" src="@audio.Url"></audio>
                    }
                </div>
            }
        </div>

        @if (word.Topics.Count > 0)
        {
            <div class="topic-list" aria-label="@L["Vocab.Detail.Topics"]">
                @foreach (var topic in word.Topics)
                {
                    <span class="topic-chip">@topic.Name</span>
                }
            </div>
        }
    </div>
</section>

<div class="detail-grid">
    <main class="detail-main-column">
        <section class="detail-panel" aria-labelledby="senses-title">
            <div class="detail-panel__header">
                <div>
                    <span class="section-index">@word.Senses.Count</span>
                    <h2 id="senses-title">@L["Sense.SectionTitle"]</h2>
                    <p>@L["Sense.SectionSubtitle"]</p>
                </div>
                <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#new-sense-form" aria-expanded="false">
                    @L["Sense.Add"]
                </button>
            </div>

            <div class="collapse sense-create" id="new-sense-form">
                <form class="ajax-detail-form sense-form" action="/vocabulary/@word.WordId/senses" method="post">
                    @Html.AntiForgeryToken()
                    <div class="sense-form-grid">
                        <label class="form-field sense-order-field">
                            <span>@L["Sense.Order"]</span>
                            <input class="form-control" type="number" name="SenseOrder" min="1" value="@(word.Senses.Count + 1)" required />
                        </label>
                        <label class="form-field">
                            <span>@L["Sense.WordClass"]</span>
                            <input class="form-control" name="WordClass" required />
                        </label>
                        <label class="form-field sense-definition-field">
                            <span>@L["Sense.EnglishDefinition"]</span>
                            <textarea class="form-control" name="EnglishDefinition" rows="3" required></textarea>
                        </label>
                        <label class="form-field sense-definition-field">
                            <span>@L["Sense.VietnameseMeaning"]</span>
                            <textarea class="form-control" name="VietnameseMeaning" rows="3"></textarea>
                        </label>
                    </div>
                    <div class="sense-form-actions">
                        <button class="btn btn-primary" type="submit">@L["Sense.Create"]</button>
                    </div>
                </form>
            </div>

            @if (word.Senses.Count == 0)
            {
                <div class="detail-empty">
                    <strong>@L["Sense.Empty.Title"]</strong>
                    <span>@L["Sense.Empty.Message"]</span>
                </div>
            }
            else
            {
                <div class="accordion sense-accordion" id="sense-accordion">
                    @foreach (var sense in word.Senses.OrderBy(item => item.Order))
                    {
                        var collapseId = $"sense-{sense.SenseId}";
                        <article class="accordion-item sense-card">
                            <h3 class="accordion-header">
                                <button class="accordion-button @(sense.Order == word.Senses.Min(item => item.Order) ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                    <span class="sense-number">@sense.Order.ToString("00")</span>
                                    <span class="sense-heading-copy">
                                        <span class="word-class">@sense.WordClass</span>
                                        <span>@sense.EnglishDefinition</span>
                                    </span>
                                </button>
                            </h3>
                            <div id="@collapseId" class="accordion-collapse collapse @(sense.Order == word.Senses.Min(item => item.Order) ? "show" : "")" data-bs-parent="#sense-accordion">
                                <div class="accordion-body">
                                    <form class="ajax-detail-form sense-form" action="/vocabulary/@word.WordId/senses/@sense.SenseId/edit" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="sense-form-grid">
                                            <label class="form-field sense-order-field">
                                                <span>@L["Sense.Order"]</span>
                                                <input class="form-control" type="number" name="SenseOrder" min="1" value="@sense.Order" required />
                                            </label>
                                            <label class="form-field">
                                                <span>@L["Sense.WordClass"]</span>
                                                <input class="form-control" name="WordClass" value="@sense.WordClass" required />
                                            </label>
                                            <label class="form-field sense-definition-field">
                                                <span>@L["Sense.EnglishDefinition"]</span>
                                                <textarea class="form-control" name="EnglishDefinition" rows="3" required>@sense.EnglishDefinition</textarea>
                                            </label>
                                            <label class="form-field sense-definition-field">
                                                <span>@L["Sense.VietnameseMeaning"]</span>
                                                <textarea class="form-control" name="VietnameseMeaning" rows="3">@sense.VietnameseMeaning</textarea>
                                            </label>
                                        </div>
                                        <div class="sense-form-actions">
                                            <button class="btn btn-primary" type="submit">@L["Common.SaveChanges"]</button>
                                            <button class="btn btn-outline-danger" type="button" disabled="@(!Model.SenseDeleteAvailable)" title="@L["Sense.DeletePending"]">@L["Common.Delete"]</button>
                                        </div>
                                    </form>

                                    <div class="examples-block">
                                        <div class="examples-heading">
                                            <h4>@L["Example.Title"]</h4>
                                            <button class="btn btn-sm btn-secondary" type="button" disabled="@(!Model.ExampleMutationAvailable)" title="@L["Example.ApiPending"]">@L["Example.Add"]</button>
                                        </div>
                                        @if (sense.Examples.Count == 0)
                                        {
                                            <p class="examples-empty">@L["Example.Empty"]</p>
                                        }
                                        else
                                        {
                                            <ol class="example-list">
                                                @foreach (var example in sense.Examples.OrderBy(item => item.Order))
                                                {
                                                    <li>
                                                        <span>@example.ExampleEn</span>
                                                        @if (!string.IsNullOrWhiteSpace(example.ExampleVi))
                                                        {
                                                            <em>@example.ExampleVi</em>
                                                        }
                                                    </li>
                                                }
                                            </ol>
                                        }
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="detail-panel" aria-labelledby="relations-title">
            <div class="detail-panel__header compact">
                <div>
                    <h2 id="relations-title">@L["Relation.Title"]</h2>
                    <p>@L["Relation.Subtitle"]</p>
                </div>
            </div>
            @if (allRelations.Count == 0)
            {
                <p class="examples-empty">@L["Relation.Empty"]</p>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead><tr><th>@L["Relation.Type"]</th><th>@L["Relation.Word"]</th><th>@L["Relation.Scope"]</th></tr></thead>
                        <tbody>
                        @foreach (var relation in allRelations)
                        {
                            <tr>
                                <td><span class="relation-kind relation-kind--@relation.RelationType.ToLowerInvariant()">@relation.RelationType</span></td>
                                <td>
                                    @if (relation.LinkedWordId is > 0)
                                    {
                                        <a href="/vocabulary/@relation.LinkedWordId">@relation.RelatedWord</a>
                                    }
                                    else
                                    {
                                        @relation.RelatedWord
                                    }
                                </td>
                                <td>@(relation.SenseId is null ? L["Relation.WholeWord"] : L["Relation.Sense"])</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </main>

    <aside class="detail-side-column">
        <section class="detail-panel media-panel" aria-labelledby="image-title">
            <div class="detail-panel__header compact"><div><h2 id="image-title">@L["Image.Title"]</h2><p>@L["Image.Subtitle"]</p></div></div>
            <form class="ajax-detail-form media-form" action="/vocabulary/@word.WordId/image" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label class="drop-field">
                    <span>@L["Image.Choose"]</span>
                    <small>@L["Image.Hint"]</small>
                    <input type="file" name="file" accept="image/jpeg,image/png,image/webp" required />
                </label>
                <button class="btn btn-primary" type="submit">@L["Image.Upload"]</button>
            </form>
            <details class="image-url-editor">
                <summary>@L["Image.UseUrl"]</summary>
                <form class="ajax-detail-form" action="/vocabulary/@word.WordId/image-url" method="post">
                    @Html.AntiForgeryToken()
                    <input class="form-control" type="url" name="imageUrl" value="@word.ImageUrl" placeholder="https://" />
                    <button class="btn btn-secondary" type="submit">@L["Common.Save"]</button>
                </form>
            </details>
        </section>

        <section class="detail-panel media-panel" aria-labelledby="audio-title">
            <div class="detail-panel__header compact"><div><h2 id="audio-title">@L["Audio.Title"]</h2><p>@L["Audio.Subtitle"]</p></div><span class="section-index">@word.Audio.Count</span></div>
            <div class="audio-list">
                @foreach (var audio in word.Audio)
                {
                    <div class="audio-item">
                        <div class="audio-item__meta"><strong>@audio.Accent.ToUpperInvariant()</strong><span>@audio.Source</span></div>
                        <audio controls preload="none" src="@audio.Url"></audio>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-confirm-url="/vocabulary/@word.WordId/audio/@audio.AudioId/delete"
                                data-confirm-message="@L["Confirm.DeleteAudio"]"
                                data-confirm-variant="danger"
                                data-confirm-ok="@L["Common.Delete"]">@L["Common.Delete"]</button>
                    </div>
                }
            </div>
            <form class="ajax-detail-form media-form" action="/vocabulary/@word.WordId/audio" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label class="form-field">
                    <span>@L["Audio.Accent"]</span>
                    <select class="form-select" name="accent" required><option value="uk">UK</option><option value="us">US</option></select>
                </label>
                <label class="drop-field">
                    <span>@L["Audio.Choose"]</span>
                    <small>@L["Audio.Hint"]</small>
                    <input type="file" name="file" accept="audio/mpeg,audio/wav,audio/ogg" required />
                </label>
                <button class="btn btn-primary" type="submit">@L["Audio.Upload"]</button>
            </form>
        </section>
    </aside>
</div>

<div id="detail-page-config" hidden
     data-error="@L["Toast.ActionFailed"]"
     data-working="@L["Common.Working"]"></div>

@section Scripts {
    <script src="~/js/vocabulary-detail.js" asp-append-version="true"></script>
}
