@{
    ViewData["Title"] = T["Import vocabulary"];
}

@Html.AntiForgeryToken()

<div class="page-header page-header-row">
    <div>
        <a class="btn-primary page-back-button" href="/vocabulary">@T["Back"]</a>
        <h1 class="page-title">@T["Import vocabulary (CSV)"]</h1>
    </div>
</div>

<div class="panel">
    <p class="panel-muted">
        @T["Expected columns:"]
        <code>word, cefr_level, phonetic_uk, phonetic_us, word_class, english_definition, vietnamese_meaning</code>.
        @T["Optional columns:"]
        <code>is_phrase, topic_names, example_en, example_vi, image_url</code>.
        <a href="/vocabulary/import/template">@T["Download template CSV"]</a>
    </p>

    <form id="import-form"
          data-msg-choose="@T["Please choose a CSV file."]"
          data-msg-failed="@T["Import failed."]"
          data-msg-request-failed="@T["Import request failed."]">
        <label id="drop-zone" class="drop-zone" for="csv-file">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="drop-icon"><path d="M12 3v12m0-12 4 4m-4-4-4 4M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="drop-text">@T["Drag & drop your CSV here, or click to choose a file"]</span>
            <span class="drop-file" id="drop-file"></span>
            <input type="file" id="csv-file" name="file" accept=".csv,text/csv" hidden />
        </label>
        <button type="submit" class="btn-primary" id="import-submit"
                data-label-idle="@T["Upload & import"]" data-label-busy="@T["Importing..."]">@T["Upload & import"]</button>
    </form>
</div>

<div class="panel import-result" id="import-result" hidden>
    <div class="panel-head">
        <h2 class="panel-title">@T["Result"]</h2>
        <button type="button" class="btn-secondary btn-sm" id="download-errors" hidden>@T["Download errors as CSV"]</button>
    </div>

    <div class="stat-grid result-summary">
        <div class="stat-card"><span class="stat-label">@T["Imported words"]</span><span class="stat-value" id="r-words">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Updated words"]</span><span class="stat-value" id="r-updated">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Imported senses"]</span><span class="stat-value" id="r-senses">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Topic links"]</span><span class="stat-value" id="r-topics">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Examples"]</span><span class="stat-value" id="r-examples">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Skipped"]</span><span class="stat-value" id="r-skipped">0</span></div>
        <div class="stat-card"><span class="stat-label">@T["Errors"]</span><span class="stat-value" id="r-errors">0</span></div>
    </div>

    <div id="errors-block" hidden>
        <h4>@T["Error rows"]</h4>
        <div class="table-panel">
            <table class="data-table">
                <thead><tr><th>@T["Row #"]</th><th>@T["Column"]</th><th>@T["Message"]</th></tr></thead>
                <tbody id="errors-body"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vocabulary-import.js" asp-append-version="true"></script>
}
