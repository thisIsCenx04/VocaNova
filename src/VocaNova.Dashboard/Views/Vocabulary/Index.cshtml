@using System.Security.Claims
@using VocaNova.Dashboard.Models.Api.Dictionary
@model VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel
@{
    ViewData["Title"] = "Vocabulary Metadata Management";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? User.FindFirstValue("role") ?? string.Empty;
    var canManage = role is "admin" or "super_admin";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var pageSizes = new[] { 10, 20, 50, 100 };

    // Các tham số lọc + sort dùng chung cho mọi link (phân trang, A–Z, sort header).
    List<string> BaseQuery()
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Q)) qs.Add($"q={Uri.EscapeDataString(Model.Q)}");
        if (!string.IsNullOrWhiteSpace(Model.Cefr)) qs.Add($"cefr={Uri.EscapeDataString(Model.Cefr)}");
        if (!string.IsNullOrWhiteSpace(Model.WordType)) qs.Add($"wordType={Uri.EscapeDataString(Model.WordType)}");
        if (Model.TopicId is { } tid) qs.Add($"topicId={tid}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) qs.Add($"status={Uri.EscapeDataString(Model.Status)}");
        if (Model.IncludeDeleted) qs.Add("includeDeleted=true");
        return qs;
    }

    string PageUrl(int page)
    {
        var qs = BaseQuery();
        if (!string.IsNullOrWhiteSpace(Model.SortBy)) qs.Add($"sortBy={Model.SortBy}");
        if (!string.IsNullOrWhiteSpace(Model.SortDirection)) qs.Add($"sortDirection={Model.SortDirection}");
        qs.Add($"limit={Model.Limit}");
        qs.Add($"page={page}");
        return "/vocabulary?" + string.Join("&", qs);
    }

    // Bấm vào tên cột: đang sort tăng theo cột đó thì đảo sang giảm, còn lại thì tăng. Reset về trang 1.
    string SortUrl(string column)
    {
        var direction = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        var qs = BaseQuery();
        qs.Add($"limit={Model.Limit}");
        qs.Add("page=1");
        qs.Add($"sortBy={column}");
        qs.Add($"sortDirection={direction}");
        return "/vocabulary?" + string.Join("&", qs);
    }

    string StatusBadgeClass(string status) => status == "deleted" ? "badge badge-danger" : "badge badge-success";

    // Thanh A–Z: giữ nguyên mọi filter + sort, chỉ đổi q = chữ cái (hoặc bỏ q khi "Tất cả"); page reset về 1.
    string LetterUrl(string? letter)
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(letter)) qs.Add($"q={Uri.EscapeDataString(letter)}");
        if (!string.IsNullOrWhiteSpace(Model.Cefr)) qs.Add($"cefr={Uri.EscapeDataString(Model.Cefr)}");
        if (!string.IsNullOrWhiteSpace(Model.WordType)) qs.Add($"wordType={Uri.EscapeDataString(Model.WordType)}");
        if (Model.TopicId is { } tid) qs.Add($"topicId={tid}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) qs.Add($"status={Uri.EscapeDataString(Model.Status)}");
        if (Model.IncludeDeleted) qs.Add("includeDeleted=true");
        if (!string.IsNullOrWhiteSpace(Model.SortBy)) qs.Add($"sortBy={Model.SortBy}");
        if (!string.IsNullOrWhiteSpace(Model.SortDirection)) qs.Add($"sortDirection={Model.SortDirection}");
        qs.Add($"limit={Model.Limit}");
        return qs.Count == 0 ? "/vocabulary" : "/vocabulary?" + string.Join("&", qs);
    }

    // Class icon cho header: caret lên/xuống nếu đang sort cột đó, mờ hai chiều nếu chưa.
    string SortIcon(string column) => Model.SortBy != column
        ? "bi bi-arrow-down-up th-sort-idle"
        : (Model.SortDirection == "desc" ? "bi bi-caret-down-fill" : "bi bi-caret-up-fill");

    // Chữ cái đang chọn = khi q đúng 1 ký tự chữ (A–Z). Prefix search dài hơn không highlight chữ nào.
    char? selectedLetter = !string.IsNullOrEmpty(Model.Q) && Model.Q.Length == 1 && char.IsLetter(Model.Q[0])
        ? char.ToUpperInvariant(Model.Q[0])
        : null;
}

<div class="page-header page-header-row">
    <div>
        <h1 class="page-title">@T["Vocabulary Metadata Management"]</h1>
    </div>
    @if (canManage)
    {
        <div class="header-actions">
            <a href="/vocabulary/import" class="btn-secondary">@T["Import CSV"]</a>
            <a href="/vocabulary/create" class="btn-primary">@T["Add vocabulary"]</a>
        </div>
    }
</div>

@if (TempData["VocabSuccess"] is string okMsg)
{
    <div class="alert alert-success">@T[okMsg]</div>
}
@if (TempData["VocabError"] is string errMsg)
{
    <div class="alert alert-danger">@T[errMsg]</div>
}

<form method="get" action="/vocabulary" class="filter-bar">
    <input type="hidden" name="limit" value="@Model.Limit" />
    @if (!string.IsNullOrWhiteSpace(Model.SortBy)) { <input type="hidden" name="sortBy" value="@Model.SortBy" /> }
    @if (!string.IsNullOrWhiteSpace(Model.SortDirection)) { <input type="hidden" name="sortDirection" value="@Model.SortDirection" /> }
    <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="@T["Search for vocabulary..."]" />
    <select name="cefr" class="form-control">
        <option value="">@T["CEFR Level"]</option>
        @foreach (var level in VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel.CefrLevels)
        {
            <option value="@level" selected="@(string.Equals(Model.Cefr, level, StringComparison.OrdinalIgnoreCase))">@level</option>
        }
    </select>
    <select name="wordType" class="form-control">
        <option value="">@T["Word Type"]</option>
        @foreach (var wt in VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel.WordTypes)
        {
            var wordTypeLabel = char.ToUpper(wt[0]) + wt[1..];
            <option value="@wt" selected="@(Model.WordType == wt)">@T[wordTypeLabel]</option>
        }
    </select>
    <select name="topicId" class="form-control">
        <option value="">@T["All topics"]</option>
        @foreach (var topic in Model.Topics)
        {
            <option value="@topic.TopicId" selected="@(Model.TopicId == topic.TopicId)">@topic.Name</option>
        }
    </select>
    <select name="status" class="form-control">
        <option value="">@T["Any status"]</option>
        <option value="active" selected="@(Model.Status == "active")">@T["Active"]</option>
        <option value="deleted" selected="@(Model.Status == "deleted")">@T["Deleted"]</option>
    </select>
    <label class="checkbox-inline">
        <input type="checkbox" name="includeDeleted" value="true" checked="@Model.IncludeDeleted" />
        @T["Show deleted"]
    </label>
    <button type="submit" class="btn-primary">@T["Filter"]</button>
    <a href="/vocabulary" class="btn-secondary">@T["Reset"]</a>
</form>

<nav class="alpha-bar" aria-label="@T["Filter by first letter"]">
    <a class="alpha-link @(string.IsNullOrWhiteSpace(Model.Q) ? "active" : "")" href="@LetterUrl(null)">@T["All"]</a>
    @for (var c = 'A'; c <= 'Z'; c++)
    {
        <a class="alpha-link @(selectedLetter == c ? "active" : "")" href="@LetterUrl(c.ToString())" aria-label="@c">@c</a>
    }
</nav>

<div class="panel table-panel">
    <table class="data-table">
        <thead>
            <tr>
                <th>
                    <a class="th-sort @(Model.SortBy == "word" ? "active" : "")" href="@SortUrl("word")">
                        @T["Vocabulary"] <i class="@SortIcon("word")" aria-hidden="true"></i>
                    </a>
                </th>
                <th style="width:130px;">
                    <a class="th-sort @(Model.SortBy == "type" ? "active" : "")" href="@SortUrl("type")">
                        @T["Word Type"] <i class="@SortIcon("type")" aria-hidden="true"></i>
                    </a>
                </th>
                <th style="width:80px;">
                    <a class="th-sort @(Model.SortBy == "cefr" ? "active" : "")" href="@SortUrl("cefr")">
                        @T["Level"] <i class="@SortIcon("cefr")" aria-hidden="true"></i>
                    </a>
                </th>
                <th style="width:150px;">
                    <a class="th-sort @(Model.SortBy == "phonetic" ? "active" : "")" href="@SortUrl("phonetic")">
                        @T["Phonetics"] <i class="@SortIcon("phonetic")" aria-hidden="true"></i>
                    </a>
                </th>
                <th style="width:110px;">
                    <a class="th-sort @(Model.SortBy == "status" ? "active" : "")" href="@SortUrl("status")">
                        @T["Status"] <i class="@SortIcon("status")" aria-hidden="true"></i>
                    </a>
                </th>
                <th style="width:120px;" class="col-actions">@T["Action"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="empty-row">@T["No words found."]</td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (string.IsNullOrWhiteSpace(item.Word))
                            {
                                <a class="vocab-word vocab-empty" href="/vocabulary/@item.WordId">@T["(no word)"]</a>
                            }
                            else
                            {
                                <a class="vocab-word" href="/vocabulary/@item.WordId">@item.Word</a>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.WordType) ? "—" : T[char.ToUpper(item.WordType[0]) + item.WordType[1..]])</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Cefr))
                            {
                                <span class="badge cefr cefr-@item.Cefr.ToLowerInvariant()">@item.Cefr</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="phonetics-cell">@(string.IsNullOrWhiteSpace(item.Phonetic) ? "—" : item.Phonetic)</td>
                        <td><span class="@StatusBadgeClass(item.Status)">@(item.Status == "active" ? T["Active"] : item.Status == "deleted" ? T["Deleted"] : T[item.Status])</span></td>
                        <td class="col-actions">
                            <div class="action-icons">
                                <a class="icon-link" href="/vocabulary/@item.WordId" title="@T["View details"]" aria-label="@T["View details"]">
                                    <svg viewBox="0 0 24 24"><path d="M12 5c-5 0-8.5 4.5-9.5 7 1 2.5 4.5 7 9.5 7s8.5-4.5 9.5-7c-1-2.5-4.5-7-9.5-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                                </a>
                                @if (canManage)
                                {
                                    <a class="icon-link" href="/vocabulary/@item.WordId/edit" title="@T["Edit"]" aria-label="@T["Edit"]">
                                        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25ZM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83Z"/></svg>
                                    </a>
                                }
                                @if (canManage && item.Status == "active")
                                {
                                    <form method="post" action="/vocabulary/delete" class="inline-form js-confirm"
                                          data-word="@item.Word"
                                          data-confirm="@(T.Format("Delete '{0}'? It will be soft-deleted.", item.Word))">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.WordId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="icon-link danger" title="@T["Delete"]" aria-label="@T["Delete"]">
                                            <svg viewBox="0 0 24 24"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-1 12H7L6 9Zm4 2v8h2v-8h-2Z"/></svg>
                                        </button>
                                    </form>
                                }
                                else if (canManage && item.Status == "deleted")
                                {
                                    <form method="post" action="/vocabulary/restore" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.WordId" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="icon-link ok" title="@T["Restore"]" aria-label="@T["Restore"]">
                                            <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-foot-bar">
    <form method="get" action="/vocabulary" class="page-size-form">
        @if (!string.IsNullOrWhiteSpace(Model.Q)) { <input type="hidden" name="q" value="@Model.Q" /> }
        @if (!string.IsNullOrWhiteSpace(Model.Cefr)) { <input type="hidden" name="cefr" value="@Model.Cefr" /> }
        @if (!string.IsNullOrWhiteSpace(Model.WordType)) { <input type="hidden" name="wordType" value="@Model.WordType" /> }
        @if (Model.TopicId is { } topicId) { <input type="hidden" name="topicId" value="@topicId" /> }
        @if (!string.IsNullOrWhiteSpace(Model.Status)) { <input type="hidden" name="status" value="@Model.Status" /> }
        @if (Model.IncludeDeleted) { <input type="hidden" name="includeDeleted" value="true" /> }
        @if (!string.IsNullOrWhiteSpace(Model.SortBy)) { <input type="hidden" name="sortBy" value="@Model.SortBy" /> }
        @if (!string.IsNullOrWhiteSpace(Model.SortDirection)) { <input type="hidden" name="sortDirection" value="@Model.SortDirection" /> }
        <label class="page-size-control">
            <span>@T["Items per page"]</span>
            <select name="limit" class="form-control" data-page-size-select aria-label="@T["Items per page"]">
                @foreach (var size in pageSizes)
                {
                    <option value="@size" selected="@(Model.Limit == size)">@size</option>
                }
            </select>
        </label>
    </form>
    @if (Model.TotalPages > 1)
    {
        var winStart = Math.Max(1, Model.Page - 2);
        var winEnd = Math.Min(Model.TotalPages, winStart + 4);
        winStart = Math.Max(1, winEnd - 4);
        <nav class="pager" aria-label="@T["Pagination"]" data-page="@Model.Page" data-total-pages="@Model.TotalPages">
            @if (Model.HasPrevious)
            {
                <a class="pager-link" href="@PageUrl(Model.Page - 1)">@T["‹ Prev"]</a>
            }
            else
            {
                <span class="pager-link disabled">@T["‹ Prev"]</span>
            }
            @for (var p = winStart; p <= winEnd; p++)
            {
                <a class="pager-link @(p == Model.Page ? "active" : "")" href="@PageUrl(p)">@p</a>
            }
            @if (Model.HasNext)
            {
                <a class="pager-link" href="@PageUrl(Model.Page + 1)">@T["Next ›"]</a>
            }
            else
            {
                <span class="pager-link disabled">@T["Next ›"]</span>
            }
        </nav>
    }
</div>

<div class="modal-overlay" id="delete-modal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <div class="modal-icon err">
            <svg viewBox="0 0 24 24"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-1 12H7L6 9Zm4 2v8h2v-8h-2Z"/></svg>
        </div>
        <h3 class="modal-title" id="delete-modal-title">@T["Delete vocabulary"]</h3>
        <p class="modal-text">
            @T["Delete"] <strong id="delete-modal-word"></strong>?
            @T["It will be soft-deleted and can be restored later."]
        </p>
        <div class="modal-actions">
            <button type="button" class="btn-secondary" data-close-modal>@T["Cancel"]</button>
            <button type="button" class="btn-danger-solid" id="delete-modal-confirm">@T["Delete"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vocabulary-list.js" asp-append-version="true"></script>
}
