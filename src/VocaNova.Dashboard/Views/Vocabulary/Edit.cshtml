@using VocaNova.Dashboard.Data.Dtos.Dictionary
@using VocaNova.Dashboard.Models.Vocabulary
@model WordDetail
@{
    ViewData["Title"] = T["Update Vocabulary Metadata"];
    var senses = Model.Senses.OrderBy(s => s.Order).ToList();
    var primaryType = senses.FirstOrDefault()?.WordClass;
    var ukAudio = Model.Audio.FirstOrDefault(a => string.Equals(a.Accent, "uk", StringComparison.OrdinalIgnoreCase))
                  ?? Model.Audio.FirstOrDefault();
    var usAudio = Model.Audio.FirstOrDefault(a => string.Equals(a.Accent, "us", StringComparison.OrdinalIgnoreCase));
    var isActive = !string.Equals(Model.Status, "deleted", StringComparison.OrdinalIgnoreCase);

}

<div class="page-header page-header-row vocabulary-edit-header">
    <div>
        <a class="btn-primary page-back-button" href="/vocabulary">@T["Back"]</a>
        <h1 class="page-title">@T["Edit vocabulary"]</h1>
    </div>
</div>

@if (TempData["VocabError"] is string errMsg)
{
    <div class="alert alert-danger">@T[errMsg]</div>
}

<form method="post" action="/vocabulary/@Model.WordId/edit" class="edit-form" id="vocabulary-edit-form"
      data-word-id="@Model.WordId"
      data-msg-request-failed="@T["Request failed."]"
      data-msg-image-required="@T["Please choose an image file."]"
      data-msg-audio-required="@T["Please choose an audio file."]"
      data-msg-delete-image="@T["Remove image"]"
      data-msg-delete-audio="@T["Delete this audio?"]"
      data-label-image-preview="@T["Image preview"]" data-label-delete="@T["Delete"]"
      data-label-replace="@T["Replace"]" data-label-no-image="@T["No image."]"
      data-label-no-audio="@T["No audio."]" data-label-upload-image="@T["Upload image"]"
      data-label-upload-audio="@T["Upload audio"]">
    @Html.AntiForgeryToken()
    <input type="hidden" name="phoneticUs" value="@Model.PhoneticUs" />
    <input type="hidden" name="imageUrl" id="edit-image-url" value="@Model.ImageUrl" />
    <input type="hidden" name="isPhrase" value="@Model.IsPhrase.ToString().ToLowerInvariant()" />
    <input type="hidden" name="wasActive" value="@isActive.ToString().ToLowerInvariant()" />

    <div class="edit-main">
        <!-- Status -->
        <section class="panel edit-panel edit-status-panel">
            <header class="edit-panel-head">
                <h2 class="edit-panel-title">@T["Status"]</h2>
            </header>
            <div class="edit-panel-body">
                <div class="status-toggle-row">
                    <span class="status-label @(isActive ? "is-active" : "is-inactive")" id="status-label"
                          data-active="@T["Active"]" data-inactive="@T["Inactive"]">@(isActive ? T["Active"] : T["Inactive"])</span>
                    <label class="switch">
                        <input type="checkbox" name="isActive" value="true" id="isActive" @(isActive ? "checked" : "") />
                        <span class="switch-track"><span class="switch-thumb"></span></span>
                    </label>
                    <input type="hidden" name="isActive" value="false" />
                </div>
            </div>
        </section>

            <!-- Vocabulary information -->
            <section class="panel edit-panel">
                <header class="edit-panel-head">
                    <span class="edit-panel-icon">
                        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Zm1.5 11h-3v-1.4h.8V12h-.8v-1.4h2.2v5.6h.8V18Z" fill="currentColor"/></svg>
                    </span>
                    <h2 class="edit-panel-title">@T["Vocabulary information"]</h2>
                </header>
                <div class="edit-panel-body">
                    <div class="field-grid-3">
                        <div class="form-group">
                            <label for="word">@T["Word"]</label>
                            <input id="word" name="word" class="form-control" value="@Model.Word" required />
                        </div>
                        <div class="form-group">
                            <label for="wordType">@T["Word Type"]</label>
                            <select id="wordType" name="wordType" class="form-control">
                                <option value="">—</option>
                                @foreach (var wt in VocabularyListViewModel.WordTypes)
                                {
                                    var wordTypeLabel = char.ToUpper(wt[0]) + wt[1..];
                                    <option value="@wt" selected="@(string.Equals(primaryType, wt, StringComparison.OrdinalIgnoreCase))">@T[wordTypeLabel]</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="cefr">@T["CEFR Level"]</label>
                            <select id="cefr" name="cefr" class="form-control">
                                <option value="">—</option>
                                @foreach (var level in VocabularyListViewModel.CefrLevels)
                                {
                                    <option value="@level" selected="@(string.Equals(Model.Cefr, level, StringComparison.OrdinalIgnoreCase))">@level</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="phoneticUk">@T["Phonetics - UK"]</label>
                        <div class="input-with-audio">
                            <input id="phoneticUk" name="phoneticUk" class="form-control" value="@Model.PhoneticUk" placeholder="/.../" />
                            @if (ukAudio is not null)
                            {
                                <button type="button" class="audio-btn" title="@T["Play"]" data-audio="@ukAudio.Url" aria-label="@T["Play pronunciation"]">
                                    <svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3Zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm-2.5-9v2.06A7 7 0 0 1 14 21v-2.06A5 5 0 0 0 14 5Z"/></svg>
                                </button>
                            }
                            else
                            {
                                <span class="audio-btn disabled" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3Z"/></svg>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <div class="vd-manage-grid edit-media-grid">
                <section class="panel vd-extra">
                    <div class="panel-head"><h2 class="panel-title">@T["Image"]</h2></div>
                    <div class="edit-media-panel-body">
                        <div id="edit-image-preview">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <div class="word-image-review">
                                    <a class="word-image-preview" href="@Model.ImageUrl" target="_blank" rel="noopener" title="@T["Open full image"]">
                                        <img class="word-image" src="@Model.ImageUrl" alt="@Model.Word" />
                                    </a>
                                    <div class="word-image-review-meta">
                                        <span>@T["Image preview"]</span>
                                        <button type="button" class="btn-icon btn-danger edit-media-delete" data-delete-media="image">@T["Delete"]</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">@T["No image."]</p>
                            }
                        </div>
                        <input id="edit-image-file" type="file" accept="image/png,image/jpeg,image/webp" hidden />
                        <button type="button" class="btn-secondary btn-sm" data-file-picker="edit-image-file">@T["Upload image"]</button>
                    </div>
                </section>

                <section class="panel vd-extra">
                    <div class="panel-head"><h2 class="panel-title">@T["Audio"]</h2></div>
                    <div class="edit-media-panel-body">
                        <div id="edit-audio-preview">
                            @if (usAudio is null)
                            {
                                <p class="text-muted">@T["No audio."]</p>
                            }
                            else
                            {
                                <ul class="audio-list"><li class="audio-item">
                                    <span class="badge badge-muted">US</span>
                                    <audio controls preload="none" src="@usAudio.Url"></audio>
                                    <button type="button" class="btn-icon btn-danger edit-media-delete"
                                            data-delete-media="audio" data-audio-id="@usAudio.AudioId">@T["Delete"]</button>
                                </li></ul>
                            }
                        </div>
                        <input id="edit-audio-file" type="file" accept="audio/mpeg,audio/wav,audio/ogg" hidden />
                        <button type="button" class="btn-secondary btn-sm" data-file-picker="edit-audio-file">@(usAudio is null ? T["Upload audio"] : T["Replace"])</button>
                    </div>
                </section>
            </div>

            <!-- Meaning & Examples -->
            <section class="panel edit-panel">
                <header class="edit-panel-head">
                    <span class="edit-panel-icon">
                        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 4h9a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 8h5M9 12h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <h2 class="edit-panel-title">@T["Meaning & Examples"]</h2>
                </header>
                <div class="edit-panel-body">
                    @if (senses.Count == 0)
                    {
                        <p class="text-muted">@T["No meanings yet. Add the first one below."]</p>
                    }
                    @{ var idx = 0; }
                    @foreach (var sense in senses)
                    {
                        <div class="meaning-block" data-sense-idx="@idx">
                            <span class="meaning-badge">@T["Meaning"] @(idx + 1)</span>
                            <input type="hidden" name="senseId" value="@sense.SenseId" />
                            <input type="hidden" name="senseOrder" value="@sense.Order" />
                            <input type="hidden" name="senseWordClass" value="@sense.WordClass" />
                            <div class="field-grid-2">
                                <div class="form-group">
                                    <label>@T["English meaning"]</label>
                                    <textarea name="englishDefinition" class="form-control" rows="2">@sense.EnglishDefinition</textarea>
                                </div>
                                <div class="form-group">
                                    <label>@T["Vietnamese meaning"]</label>
                                    <textarea name="vietnameseMeaning" class="form-control" rows="2">@sense.VietnameseMeaning</textarea>
                                </div>
                            </div>

                            <span class="meaning-badge subtle">@T["Example"]</span>
                            <div class="example-rows">
                                @foreach (var ex in sense.Examples.OrderBy(e => e.Order))
                                {
                                    <div class="example-row">
                                        <input type="hidden" name="exampleSenseIdx" value="@idx" />
                                        <input type="hidden" name="exampleId" value="@ex.ExampleId" />
                                        <div class="field-grid-2">
                                            <div class="form-group">
                                                <label>@T["English example"]</label>
                                                <textarea name="exampleEn" class="form-control" rows="2">@ex.ExampleEn</textarea>
                                            </div>
                                            <div class="form-group">
                                                <label>@T["Vietnamese example"]</label>
                                                <textarea name="exampleVi" class="form-control" rows="2">@ex.ExampleVi</textarea>
                                            </div>
                                        </div>
                                        <button type="button" class="example-remove is-locked" disabled
                                                title="@T["Removing saved examples is temporarily disabled."]"
                                                aria-label="@T["Remove"]">✕</button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="add-example-link">+ @T["Add example"]</button>
                        </div>
                        idx++;
                    }

                    <!-- Template cho 1 dòng ví dụ mới (JS clone) -->
                    <template id="example-row-tpl">
                        <div class="example-row">
                            <input type="hidden" name="exampleSenseIdx" value="0" />
                            <input type="hidden" name="exampleId" value="0" />
                            <div class="field-grid-2">
                                <div class="form-group">
                                    <label>@T["English example"]</label>
                                    <textarea name="exampleEn" class="form-control" rows="2"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>@T["Vietnamese example"]</label>
                                    <textarea name="exampleVi" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                            <button type="button" class="example-remove" aria-label="@T["Remove"]">✕</button>
                        </div>
                    </template>

                    <!-- New meaning (hidden until toggled) -->
                    <div class="meaning-block new-meaning" id="new-meaning" hidden>
                        <span class="meaning-badge">@T["New meaning"]</span>
                        <div class="field-grid-2">
                            <div class="form-group">
                                <label>@T["English meaning"]</label>
                                <textarea name="newEnglishDefinition" class="form-control" rows="2" placeholder="@T["Definition in English"]"></textarea>
                            </div>
                            <div class="form-group">
                                <label>@T["Vietnamese meaning"]</label>
                                <textarea name="newVietnameseMeaning" class="form-control" rows="2" placeholder="@T["Vietnamese meaning"]"></textarea>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="add-meaning-btn" id="add-meaning-btn">⊕ @T["Add new meaning"]</button>
                </div>
            </section>
        <div class="edit-form-actions">
            <div class="edit-form-actions-inner">
                <a href="/vocabulary" class="btn-secondary">@T["Cancel"]</a>
                <button type="submit" class="btn-primary">@T["Save changes"]</button>
            </div>
        </div>
    </div>
</form>

<div id="edit-toast" class="detail-toast" hidden></div>

<div class="confirm-modal" id="edit-media-delete-modal" hidden>
    <div class="confirm-overlay" data-close></div>
    <div class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="edit-media-delete-title">
        <span class="confirm-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-1 12H7L6 9Zm4 2v8h2v-8h-2Zm4 0v8h2v-8h-2Z" fill="currentColor"/></svg>
        </span>
        <h3 class="confirm-title" id="edit-media-delete-title">@T["Are you sure?"]</h3>
        <p class="confirm-note" id="edit-media-delete-message"></p>
        <div class="confirm-actions">
            <button type="button" class="btn-secondary" data-close>@T["Cancel"]</button>
            <button type="button" class="btn-danger-solid" id="edit-media-delete-confirm">@T["Delete"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vocabulary-edit.js" asp-append-version="true"></script>
}
