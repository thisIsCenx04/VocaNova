@model VocaNova.Dashboard.Models.Topics.TopicCreateViewModel
@{
    ViewData["Title"] = T["Create topic"];
}

<div class="page-header page-header-row">
    <div>
        <a href="/topics" class="btn-primary page-back-button">@T["Back"]</a>
        <h1 class="page-title">@T["Create topic"]</h1>
    </div>
</div>

@if (TempData["TopicError"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger validation-summary" asp-validation-summary="All"></div>
}

<form method="post" action="/topics/create" class="topic-create-form">
    @Html.AntiForgeryToken()

    <div class="panel topic-create-panel">
        <div class="panel-head"><h2 class="panel-title">@T["Topic information"]</h2></div>
        <div class="topic-create-grid">
            <div class="form-field topic-icon-field">
                <span id="topic-icon-label">@T["Icon"]</span>
                <partial name="_TopicIconPicker" model="Model.Icon" />
                <span asp-validation-for="Icon" class="field-validation-error"></span>
            </div>
            <label class="form-field">
                <span>@T["Topic name (EN)"] <strong aria-hidden="true">*</strong></span>
                <input type="text" name="TopicName" value="@Model.TopicName" class="form-control" maxlength="50" required />
                <span asp-validation-for="TopicName" class="field-validation-error"></span>
            </label>
            <label class="form-field">
                <span>@T["Topic name (VI)"]</span>
                <input type="text" name="TopicNameVi" value="@Model.TopicNameVi" class="form-control" maxlength="50" />
            </label>
        </div>
    </div>

    <div class="panel topic-create-panel">
        <div class="panel-head"><h2 class="panel-title">@T["Vocabulary"]</h2></div>
        <div class="topic-keyword-launch">
            <button id="topic-keyword-toggle" type="button" class="btn-primary" aria-expanded="false" aria-controls="topic-keyword-entry">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @T["Add word"]
            </button>
        </div>
        <div id="topic-keyword-entry" class="topic-keyword-entry" hidden>
            <div class="topic-keyword-autocomplete">
                <input id="topic-keyword-input" type="text" class="form-control" maxlength="50" placeholder="@T["Enter a keyword..."]" autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="topic-word-suggestions" />
                <div id="topic-word-suggestions" class="topic-word-suggestions" role="listbox" hidden></div>
            </div>
            <button id="topic-keyword-add" type="button" class="btn-primary">@T["Add to Topic"]</button>
            <button id="topic-keyword-cancel" type="button" class="btn-secondary">@T["Cancel adding word"]</button>
        </div>
        <p id="topic-keyword-error" class="field-validation-error topic-keyword-error" role="alert" aria-live="polite"></p>
        <span asp-validation-for="Keywords" class="field-validation-error"></span>

        <div class="filter-bar topic-create-word-filter" data-topic-client-filter>
            <input type="text" class="form-control" data-topic-filter-query placeholder="@T["Search for vocabulary..."]" />
            <select class="form-control" data-topic-filter-cefr>
                <option value="">@T["CEFR Level"]</option>
                @foreach (var level in VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel.CefrLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>
            <select class="form-control" data-topic-filter-type>
                <option value="">@T["Word Type"]</option>
                @foreach (var type in VocaNova.Dashboard.Models.Vocabulary.VocabularyListViewModel.WordTypes)
                {
                    <option value="@type">@(char.ToUpper(type[0]) + type[1..])</option>
                }
            </select>
            <select class="form-control" data-topic-filter-status>
                <option value="">@T["Any status"]</option>
                <option value="active">@T["Active"]</option>
                <option value="deleted">@T["Deleted"]</option>
            </select>
            <button type="button" class="btn-primary" data-topic-filter-apply>@T["Filter"]</button>
            <button type="button" class="btn-secondary" data-topic-filter-reset>@T["Reset"]</button>
        </div>

        @* Cùng cấu trúc bảng với Word Management và trang Edit topic. *@
        <div class="table-panel topic-word-table-panel">
            <table class="data-table" id="topic-keyword-table">
                <thead>
                    <tr>
                        <th>@T["Vocabulary"]</th>
                        <th style="width:130px;">@T["Word Type"]</th>
                        <th style="width:80px;">@T["Level"]</th>
                        <th style="width:150px;">@T["Phonetics"]</th>
                        <th style="width:110px;">@T["Status"]</th>
                        <th style="width:80px;" class="col-actions">@T["Action"]</th>
                    </tr>
                </thead>
                <tbody id="topic-keyword-list">
                    @for (var index = 0; index < Model.Keywords.Count; index++)
                    {
                        <tr class="topic-keyword-row" data-word-id="@(index < Model.WordIds.Count ? Model.WordIds[index] : 0)"
                            data-word="@Model.Keywords[index]" data-word-type="" data-cefr="" data-status="">
                            <td>
                                <span class="vocab-word">@Model.Keywords[index]</span>
                                <input type="hidden" name="Keywords" value="@Model.Keywords[index]" />
                                <input type="hidden" name="WordIds" value="@(index < Model.WordIds.Count ? Model.WordIds[index] : 0)" />
                            </td>
                            <td>—</td>
                            <td>—</td>
                            <td>—</td>
                            <td>—</td>
                            <td class="col-actions">
                                <div class="action-icons">
                                    <button type="button" class="icon-link topic-keyword-remove danger"
                                            title="@T["Remove keyword"]" aria-label="@T["Remove keyword"]">
                                        <svg viewBox="0 0 24 24"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-1 12H7L6 9Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="topic-keyword-empty" class="@(Model.Keywords.Count > 0 ? "is-hidden" : "")">
                        <td colspan="6" class="empty-row">@T["No keywords added yet."]</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="table-foot-bar" data-topic-client-pagination>
            <div class="page-size-form">
                <label class="page-size-control">
                    <span>@T["Items per page"]</span>
                    <select class="form-control" data-topic-client-page-size aria-label="@T["Items per page"]">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </label>
            </div>
            <nav class="pager" data-topic-client-pager data-prev="@T["Prev"]" data-next="@T["Next"]"
                 aria-label="@T["Topic pages"]"></nav>
        </div>
    </div>

    <div class="topic-create-actions">
        <a href="/topics" class="btn-secondary">@T["Cancel"]</a>
        <button type="submit" class="btn-primary">@T["Save topic"]</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/topic-create.js" asp-append-version="true"></script>
}
