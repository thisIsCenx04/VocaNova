<div class="topic-icon-picker" data-topic-icon-picker>
    <button type="button" class="topic-icon-trigger" data-topic-icon-trigger
            aria-haspopup="dialog" aria-labelledby="topic-icon-label">
        <span class="topic-icon-preview" data-topic-icon-preview>@(string.IsNullOrWhiteSpace(Model) ? "🎨" : Model)</span>
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
    </button>

    @* Giá trị chỉ đến từ modal, nên trường post lên là hidden thay vì ô gõ tay. *@
    <input type="hidden" name="Icon" value="@Model" data-topic-icon-input />
</div>
<small>@T["Pick an icon from the list."]</small>

<div class="modal-overlay" id="topic-icon-modal" data-topic-icon-modal role="dialog" aria-modal="true"
     aria-labelledby="topic-icon-modal-title" hidden>
    <div class="modal-card topic-icon-modal-card">
        <div class="topic-icon-modal-head">
            <h3 class="modal-title" id="topic-icon-modal-title">@T["Choose an icon"]</h3>
            <button type="button" class="topic-icon-close" data-topic-icon-close
                    aria-label="@T["Close"]">&times;</button>
        </div>

        <input type="search" class="form-control topic-icon-search" data-topic-icon-search
               placeholder="@T["Search icons..."]" autocomplete="off" aria-label="@T["Search icons..."]" />

        <div class="topic-icon-tabs" role="tablist">
            @foreach (var group in groups)
            {
                <button type="button" class="topic-icon-tab" data-topic-icon-tab="@group.Key"
                        role="tab" title="@T[group.Label]" aria-label="@T[group.Label]">@group.Tab</button>
            }
        </div>

        <div class="topic-icon-scroll" data-topic-icon-scroll>
            @foreach (var group in groups)
            {
                <section class="topic-icon-group" data-topic-icon-group="@group.Key">
                    <span class="topic-icon-group-label">@T[group.Label]</span>
                    <div class="topic-icon-grid">
                        @foreach (var (icon, keywords) in group.Icons)
                        {
                            <button type="button" class="topic-icon-option @(icon == Model ? "is-selected" : "")"
                                    data-topic-icon-option="@icon" data-keywords="@keywords"
                                    title="@icon" aria-label="@keywords">@icon</button>
                        }
                    </div>
                </section>
            }
            <p class="topic-icon-empty is-hidden" data-topic-icon-empty>@T["No icons match your search."]</p>
        </div>

        <div class="topic-icon-modal-foot">
            <button type="button" class="btn-secondary btn-sm" data-topic-icon-clear>@T["Clear"]</button>
            <button type="button" class="btn-secondary btn-sm" data-topic-icon-close>@T["Close"]</button>
        </div>
    </div>
</div>
