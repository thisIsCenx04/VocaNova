@model VocaNova.Dashboard.Models.Topics.TopicEditViewModel
@{
    ViewData["Title"] = T["Edit topic"];

    // Bấm tên cột: đang tăng theo cột đó thì đảo sang giảm, còn lại thì tăng.
    string SortUrl(string column)
    {
        var direction = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        return $"/topics/{Model.TopicId}/edit?sortBy={column}&sortDirection={direction}";
    }

    string SortIcon(string column) => Model.SortBy != column
        ? "bi bi-arrow-down-up th-sort-idle"
        : (Model.SortDirection == "desc" ? "bi bi-caret-down-fill" : "bi bi-caret-up-fill");

    string Badge(string status) => status == "deleted" ? "badge badge-danger" : "badge badge-success";
}

<div class="page-header page-header-row">
    <div>
        <a href="/topics" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>@T["Back to topics"]</a>
        <h1 class="page-title">@T["Edit topic"]</h1>
        <p class="page-subtitle">@T["Update the topic information."]</p>
    </div>
</div>

@if (TempData["TopicError"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }
@if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger validation-summary" asp-validation-summary="All"></div> }

<form method="post" action="/topics/@Model.TopicId/update" class="topic-create-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TopicId" />
    <div class="panel topic-create-panel">
        <div class="panel-head"><h2 class="panel-title">@T["Topic information"]</h2></div>
        <div class="topic-create-grid topic-edit-grid">
            <label class="form-field topic-id-field">
                <span>@T["Topic ID"]</span>
                <input value="@Model.TopicId" class="form-control" readonly aria-readonly="true" />
            </label>
            <div class="form-field topic-icon-field">
                <span id="topic-icon-label">@T["Icon"]</span>
                <partial name="_TopicIconPicker" model="Model.Icon" />
            </div>
            <label class="form-field">
                <span>@T["Topic name (EN)"] <strong aria-hidden="true">*</strong></span>
                <input asp-for="TopicName" class="form-control" maxlength="50" required />
                <span asp-validation-for="TopicName" class="field-validation-error"></span>
            </label>
            <label class="form-field">
                <span>@T["Topic name (VI)"]</span>
                <input asp-for="TopicNameVi" class="form-control" maxlength="50" />
                <span asp-validation-for="TopicNameVi" class="field-validation-error"></span>
            </label>
        </div>
    </div>

    <div class="panel topic-create-panel">
        <div class="panel-head"><h2 class="panel-title">@T["Vocabulary"]</h2></div>
        <p class="text-muted topic-keyword-help">@T["Add or remove vocabulary associated with this topic."]</p>
        <div class="topic-keyword-entry">
            <div class="topic-keyword-autocomplete">
                <input id="topic-keyword-input" type="text" class="form-control" maxlength="50" placeholder="@T["Search for vocabulary..."]" autocomplete="off" />
                <div id="topic-word-suggestions" class="topic-word-suggestions" role="listbox" hidden></div>
            </div>
            <button id="topic-keyword-add" type="button" class="btn-secondary">@T["Add to Topic"]</button>
        </div>
        <p id="topic-keyword-error" class="field-validation-error topic-keyword-error" role="alert"></p>
        <span asp-validation-for="Keywords" class="field-validation-error"></span>

        @* Cùng cấu trúc bảng với Word Management để hai trang đọc như nhau. Mỗi dòng mang theo
           hidden input nên form vẫn post đúng Keywords/WordIds như bản dùng chip trước đây. *@
        <div class="table-panel topic-word-table-panel">
            <table class="data-table" id="topic-keyword-table">
                <thead>
                    <tr>
                        <th>
                            <a class="th-sort @(Model.SortBy == "word" ? "active" : "")" href="@SortUrl("word")">
                                @T["Vocabulary"] <i class="@SortIcon("word")" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th style="width:130px;">
                            <a class="th-sort @(Model.SortBy == "type" ? "active" : "")" href="@SortUrl("type")">
                                @T["Word Type"] <i class="@SortIcon("type")" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th style="width:80px;">
                            <a class="th-sort @(Model.SortBy == "cefr" ? "active" : "")" href="@SortUrl("cefr")">
                                @T["Level"] <i class="@SortIcon("cefr")" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th style="width:150px;">
                            <a class="th-sort @(Model.SortBy == "phonetic" ? "active" : "")" href="@SortUrl("phonetic")">
                                @T["Phonetics"] <i class="@SortIcon("phonetic")" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th style="width:110px;">
                            <a class="th-sort @(Model.SortBy == "status" ? "active" : "")" href="@SortUrl("status")">
                                @T["Status"] <i class="@SortIcon("status")" aria-hidden="true"></i>
                            </a>
                        </th>
                        <th style="width:80px;" class="col-actions">@T["Action"]</th>
                    </tr>
                </thead>
                <tbody id="topic-keyword-list">
                    @for (var index = 0; index < Model.Keywords.Count; index++)
                    {
                        var word = index < Model.Words.Count ? Model.Words[index] : null;
                        var wordId = index < Model.WordIds.Count ? Model.WordIds[index] : 0;
                        <tr class="topic-keyword-row">
                            <td>
                                @if (wordId > 0)
                                {
                                    <a class="vocab-word" href="/vocabulary/@wordId">@Model.Keywords[index]</a>
                                }
                                else
                                {
                                    <span class="vocab-word">@Model.Keywords[index]</span>
                                }
                                <input type="hidden" name="Keywords" value="@Model.Keywords[index]" />
                                <input type="hidden" name="WordIds" value="@wordId" />
                            </td>
                            <td>@(word?.WordType ?? "—")</td>
                            <td>@(word?.Cefr ?? "—")</td>
                            <td>@(word?.Phonetic ?? "—")</td>
                            <td>
                                @if (word is null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="@Badge(word.Status)">@word.Status</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="action-icons">
                                    <button type="button" class="icon-link topic-keyword-remove danger"
                                            title="@T["Remove from topic"]" aria-label="@T["Remove from topic"]">
                                        <svg viewBox="0 0 24 24"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-1 12H7L6 9Z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="topic-keyword-empty" class="@(Model.Keywords.Count > 0 ? "is-hidden" : "")">
                        <td colspan="6" class="empty-row">@T["No vocabulary added yet."]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="topic-create-actions">
        <a href="/topics" class="btn-secondary">@T["Cancel"]</a>
        <button type="submit" class="btn-primary">@T["Save changes"]</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/topic-create.js" asp-append-version="true"></script>
}
