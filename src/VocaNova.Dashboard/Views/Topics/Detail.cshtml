@using VocaNova.Dashboard.Models.Vocabulary
@model VocaNova.Dashboard.Models.Topics.TopicDetailViewModel
@{
    ViewData["Title"] = "Topic details";
    string Url(int page) {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Q)) qs.Add($"q={Uri.EscapeDataString(Model.Q)}");
        if (!string.IsNullOrWhiteSpace(Model.Cefr)) qs.Add($"cefr={Uri.EscapeDataString(Model.Cefr)}");
        if (!string.IsNullOrWhiteSpace(Model.WordType)) qs.Add($"wordType={Uri.EscapeDataString(Model.WordType)}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) qs.Add($"status={Uri.EscapeDataString(Model.Status)}");
        if (Model.IncludeDeleted) qs.Add("includeDeleted=true");
        qs.Add($"page={page}");
        return $"/topics/{Model.Topic.TopicId}?{string.Join("&", qs)}";
    }
    string Badge(string status) => status == "deleted" ? "badge badge-danger" : "badge badge-success";
}

<div class="page-header page-header-row">
    <div>
        <a href="/topics" class="text-muted">&larr; @T["Topics"]</a>
        <h1 class="page-title">@(Model.Topic.Icon ?? "") @Model.Topic.TopicName</h1>
        <p class="page-subtitle">@(Model.Topic.TopicNameVi ?? T["No Vietnamese name"]) · <span class="@Badge(Model.Topic.Status)">@Model.Topic.Status</span> · @Model.TotalItems @T["word(s)."]</p>
    </div>
</div>

@if (TempData["TopicSuccess"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["TopicError"] is string topicError) { <div class="alert alert-danger">@topicError</div> }

<div class="panel topic-add-word-panel">
    <h4>@T["Add vocabulary to topic"]</h4>
    <form method="post" action="/topics/@Model.Topic.TopicId/words" id="topic-add-word-form" class="topic-keyword-entry">
        @Html.AntiForgeryToken()
        <div class="topic-keyword-autocomplete">
            <input id="topic-add-word-input" class="form-control" type="text" autocomplete="off" placeholder="@T["Search for vocabulary..."]" />
            <input id="topic-add-word-id" type="hidden" name="wordIds" />
            <div id="topic-add-word-suggestions" class="topic-word-suggestions" hidden></div>
        </div>
        <button type="submit" class="btn-primary">@T["Add to Topic"]</button>
    </form>
    <p id="topic-add-word-error" class="field-validation-error topic-keyword-error" role="alert"></p>
</div>

<form method="get" action="/topics/@Model.Topic.TopicId" class="filter-bar">
    <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="@T["Search for vocabulary..."]" />
    <select name="cefr" class="form-control"><option value="">@T["CEFR Level"]</option>
        @foreach (var level in VocabularyListViewModel.CefrLevels) { <option value="@level" selected="@(Model.Cefr == level)">@level</option> }
    </select>
    <select name="wordType" class="form-control"><option value="">@T["Word Type"]</option>
        @foreach (var type in VocabularyListViewModel.WordTypes) { <option value="@type" selected="@(Model.WordType == type)">@(char.ToUpper(type[0]) + type[1..])</option> }
    </select>
    <select name="status" class="form-control">
        <option value="">@T["Any status"]</option><option value="active" selected="@(Model.Status == "active")">@T["Active"]</option><option value="deleted" selected="@(Model.Status == "deleted")">@T["Deleted"]</option>
    </select>
    <label class="checkbox-inline"><input type="checkbox" name="includeDeleted" value="true" checked="@Model.IncludeDeleted" /> @T["Show deleted"]</label>
    <button type="submit" class="btn-primary">@T["Filter"]</button>
    <a href="/topics/@Model.Topic.TopicId" class="btn-secondary">@T["Reset"]</a>
</form>

<div class="panel table-panel"><table class="data-table">
    <thead><tr><th>@T["Vocabulary"]</th><th>@T["Word Type"]</th><th>@T["Level"]</th><th>@T["Phonetics"]</th><th>@T["Status"]</th><th class="col-actions">@T["Action"]</th></tr></thead>
    <tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-row">@T["No words found."]</td></tr> }
    @foreach (var item in Model.Items) {
        <tr><td><a class="vocab-word" href="/vocabulary/@item.WordId">@item.Word</a></td><td>@(item.WordType ?? "—")</td><td>@(item.Cefr ?? "—")</td><td>@(item.Phonetic ?? "—")</td><td><span class="@Badge(item.Status)">@item.Status</span></td><td class="col-actions"><a class="btn-icon" href="/vocabulary/@item.WordId">@T["View details"]</a></td></tr>
    }
    </tbody>
</table></div>

<div class="table-foot-bar"><span class="pager-info">@T["Showing"] @Model.Items.Count @T["of"] @Model.TotalItems @T["entries"]</span>
@if (Model.TotalPages > 1) { <nav class="pager">
    <a class="pager-link @(Model.HasPrevious ? "" : "disabled")" href="@(Model.HasPrevious ? Url(Model.Page - 1) : "#")">@T["Prev"]</a>
    @for (var p = 1; p <= Model.TotalPages; p++) { <a class="pager-link @(p == Model.Page ? "active" : "")" href="@Url(p)">@p</a> }
    <a class="pager-link @(Model.HasNext ? "" : "disabled")" href="@(Model.HasNext ? Url(Model.Page + 1) : "#")">@T["Next"]</a>
</nav> }
</div>

@section Scripts {
    <script src="~/js/topic-detail.js" asp-append-version="true"></script>
}
