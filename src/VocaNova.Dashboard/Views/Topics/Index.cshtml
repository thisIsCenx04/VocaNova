@using VocaNova.Dashboard.Models.Api.Dictionary
@model VocaNova.Dashboard.Models.Topics.TopicListViewModel
@{
    ViewData["Title"] = "Topics";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string StatusBadge(string status) => status == "deleted" ? "badge badge-danger" : "badge badge-success";
}

<div class="page-header">
    <h1 class="page-title">@T["Topics"]</h1>
    <p class="page-subtitle">@Model.Items.Count @T["topic(s). Manage topics and their words."]</p>
</div>

@if (TempData["TopicSuccess"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["TopicError"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<form method="get" action="/topics" class="filter-bar">
    <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="@T["Search topic..."]" />
    <select name="status" class="form-control">
        <option value="">@T["Any status"]</option>
        <option value="active" selected="@(Model.Status == "active")">@T["Active"]</option>
        <option value="deleted" selected="@(Model.Status == "deleted")">@T["Deleted"]</option>
    </select>
    <label class="checkbox-inline">
        <input type="checkbox" name="includeDeleted" value="true" checked="@Model.IncludeDeleted" />
        @T["Show deleted"]
    </label>
    <button type="submit" class="btn-primary">@T["Filter"]</button>
    <a href="/topics" class="btn-secondary">@T["Reset"]</a>
</form>

<div class="panel">
    <h4>@T["Add a topic"]</h4>
    <form method="post" action="/topics/create" class="form-grid topic-add-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <input type="text" name="icon" class="form-control" placeholder="@T["Icon"]" />
        <input type="text" name="topicName" class="form-control" placeholder="@T["Topic name (EN)"]" required />
        <input type="text" name="topicNameVi" class="form-control" placeholder="@T["Topic name (VI)"]" />
        <button type="submit" class="btn-primary btn-sm">@T["Add topic"]</button>
    </form>
</div>

<div class="panel table-panel">
    <table class="data-table">
        <thead>
            <tr>
                <th>@T["Icon"]</th>
                <th>@T["Topic name"]</th>
                <th>@T["Name (VI)"]</th>
                <th>@T["Status"]</th>
                <th>@T["Words"]</th>
                <th class="col-actions">@T["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="empty-row">@T["No topics found."]</td></tr>
            }
            else
            {
                foreach (var topic in Model.Items)
                {
                    <tr data-topic-row="@topic.TopicId">
                        <td>@(string.IsNullOrWhiteSpace(topic.Icon) ? "—" : topic.Icon)</td>
                        <td class="word-text">@topic.TopicName</td>
                        <td>@(topic.TopicNameVi ?? "—")</td>
                        <td><span class="@StatusBadge(topic.Status)">@topic.Status</span></td>
                        <td>@topic.WordCount</td>
                        <td class="col-actions">
                            @if (topic.Status != "deleted")
                            {
                                <button type="button" class="btn-icon js-edit-topic" data-topic-id="@topic.TopicId">@T["Edit"]</button>
                                @if (topic.WordCount > 0)
                                {
                                    <button type="button" class="btn-icon btn-danger" disabled
                                            title="@(T.Format("Cannot delete — {0} word(s) still use this topic", topic.WordCount))">@T["Delete"]</button>
                                }
                                else
                                {
                                    <form method="post" action="/topics/@topic.TopicId/delete" class="inline-form js-confirm"
                                          data-confirm="@(T.Format("Delete topic '{0}'?", topic.TopicName))">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn-icon btn-danger">@T["Delete"]</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <form method="post" action="/topics/@topic.TopicId/restore" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn-icon btn-success">@T["Restore"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                    @if (topic.Status != "deleted")
                    {
                        <tr class="edit-row" id="edit-row-@topic.TopicId" hidden>
                            <td colspan="6">
                                <form method="post" action="/topics/@topic.TopicId/update" class="form-grid">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <input type="text" name="icon" value="@topic.Icon" class="form-control" placeholder="@T["Icon"]" />
                                    <input type="text" name="topicName" value="@topic.TopicName" class="form-control" placeholder="@T["Topic name (EN)"]" required />
                                    <input type="text" name="topicNameVi" value="@topic.TopicNameVi" class="form-control" placeholder="@T["Topic name (VI)"]" />
                                    <div class="form-actions">
                                        <button type="submit" class="btn-primary btn-sm">@T["Save"]</button>
                                        <button type="button" class="btn-secondary btn-sm js-edit-cancel" data-topic-id="@topic.TopicId">@T["Cancel"]</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/topics.js" asp-append-version="true"></script>
}
