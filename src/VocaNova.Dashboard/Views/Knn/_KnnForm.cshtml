@model VocaNova.Dashboard.Models.Knn.KnnFormViewModel
@{
    var t = Model.Type;
    var action = Model.IsEdit ? "Edit" : "Create";
}
<form asp-controller="Knn" asp-action="@action" asp-route-type="@t.Key" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="text-danger small mb-3">@Model.Error</div>
    }

    <div class="form-field mb-3">
        <label for="knn-name">@L["Knn.Field.Name"]</label>
        <input id="knn-name" class="form-control" name="Name" value="@Model.Name" maxlength="@t.NameMaxLength" required autofocus />
    </div>

    @if (t.HasCode)
    {
        <div class="form-field mb-3">
            <label for="knn-code">@L["Knn.Field.Code"]</label>
            <input id="knn-code" class="form-control mono" name="Code" value="@Model.Code" maxlength="10" pattern="[A-Za-z0-9_\-]+" required />
            <small style="color: var(--muted);">@L["Knn.Field.Code.Hint"]</small>
        </div>
    }

    @if (t.HasParent)
    {
        <div class="form-field mb-3">
            <label for="knn-parent">@L["Knn.Field.Parent"]</label>
            <select id="knn-parent" class="form-select" name="ParentId">
                <option value="">@L["Knn.Field.Parent.None"]</option>
                @foreach (var p in Model.ParentOptions)
                {
                    <option value="@p.Id" selected="@(Model.ParentId == p.Id)">@p.Name (@p.Code)</option>
                }
            </select>
        </div>
    }

    @if (t.HasAge)
    {
        <div class="row g-2 mb-3">
            <div class="col form-field">
                <label for="knn-min-age">@L["Knn.Field.MinAge"]</label>
                <input id="knn-min-age" class="form-control" type="number" min="0" name="MinAge" value="@(Model.MinAge?.ToString())" />
            </div>
            <div class="col form-field">
                <label for="knn-max-age">@L["Knn.Field.MaxAge"]</label>
                <input id="knn-max-age" class="form-control" type="number" min="0" name="MaxAge" value="@(Model.MaxAge?.ToString())" />
            </div>
        </div>
    }

    @if (t.HasDescription)
    {
        <div class="form-field mb-3">
            <label for="knn-description">@L["Knn.Field.Description"]</label>
            <textarea id="knn-description" class="form-control" name="Description" maxlength="255" rows="3">@Model.Description</textarea>
        </div>
    }

    @if (t.HasDisplayOrder)
    {
        <div class="form-field mb-3">
            <label for="knn-order">@L["Knn.Field.Order"]</label>
            <input id="knn-order" class="form-control" type="number" min="0" name="DisplayOrder" value="@Model.DisplayOrder" />
        </div>
    }

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
        <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
    </div>
</form>
