@model VocaNova.Dashboard.Models.Knn.KnnListViewModel
@using VocaNova.Dashboard.Models.Components
@{
    var t = Model.Type;
    ViewData["Title"] = L[t.TitleKey];
    string PageUrl(int p) => Url.Action("Index", new { type = t.Key, q = Model.Query.Q, includeDeleted = Model.Query.IncludeDeleted, page = p, limit = Model.Query.Limit }) ?? "#";
}

<div class="page-header">
    <div>
        <p class="eyebrow">@L["Knn.Eyebrow"]</p>
        <h1>@L[t.TitleKey]</h1>
    </div>
    <button type="button" class="btn btn-primary" data-form-url="/knn/@t.Key/create" data-form-title="@L["Knn.New", L[t.SingularKey].Value]">
        @L["Knn.New", L[t.SingularKey].Value]
    </button>
</div>

<partial name="_KnnNav" model="@t.Key" />

<form class="filter-bar" method="get" asp-controller="Knn" asp-action="Index" asp-route-type="@t.Key">
    <input class="form-control" type="search" name="q" value="@Model.Query.Q" placeholder="@L["Common.Search"]" />
    <label class="d-inline-flex align-items-center gap-2" style="color: var(--muted);">
        <input type="checkbox" name="includeDeleted" value="true" checked="@Model.Query.IncludeDeleted" />
        @L["Filter.ShowDeleted"]
    </label>
    <button class="btn btn-primary" type="submit">@L["Common.Apply"]</button>
</form>

@if (!Model.Loaded)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
}
else if (Model.Items.Count == 0)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Empty, Title = L["Knn.Empty.Title"].Value, Message = L["Knn.Empty.Msg"].Value })" />
}
else
{
    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L["Knn.Col.Name"]</th>
                    @if (t.HasCode)
                    {
                        <th>@L["Knn.Col.Code"]</th>
                    }
                    @if (t.HasParent)
                    {
                        <th>@L["Knn.Col.Parent"]</th>
                    }
                    @if (t.HasAge)
                    {
                        <th>@L["Knn.Col.MinAge"]</th>
                        <th>@L["Knn.Col.MaxAge"]</th>
                    }
                    @if (t.HasDescription)
                    {
                        <th>@L["Knn.Col.Description"]</th>
                    }
                    @if (t.HasDisplayOrder)
                    {
                        <th>@L["Knn.Col.Order"]</th>
                    }
                    <th>@L["Tbl.Status"]</th>
                    <th>@L["Tbl.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var isDeleted = string.Equals(item.Status, "deleted", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        @if (t.HasCode)
                        {
                            <td><span class="mono">@item.Code</span></td>
                        }
                        @if (t.HasParent)
                        {
                            <td>@(string.IsNullOrWhiteSpace(item.ParentName) ? "—" : item.ParentName)</td>
                        }
                        @if (t.HasAge)
                        {
                            <td class="mono">@(item.MinAge?.ToString() ?? "—")</td>
                            <td class="mono">@(item.MaxAge?.ToString() ?? "—")</td>
                        }
                        @if (t.HasDescription)
                        {
                            <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                        }
                        @if (t.HasDisplayOrder)
                        {
                            <td class="mono">@item.DisplayOrder</td>
                        }
                        <td><partial name="Components/_Badge" model="@(new BadgeViewModel { Text = L["User.Status." + item.Status].Value, Modifier = BadgeModifiers.Status(item.Status) })" /></td>
                        <td>
                            <div class="row-actions">
                                @if (isDeleted)
                                {
                                    <button type="button" class="btn btn-sm btn-secondary"
                                            data-confirm-url="/knn/@t.Key/@item.Id/restore"
                                            data-confirm-message="@L["Knn.Restore.Confirm"]"
                                            data-confirm-ok="@L["Common.Restore"]">@L["Common.Restore"]</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary"
                                            data-form-url="/knn/@t.Key/@item.Id/edit"
                                            data-form-title="@L["Common.Edit"]">@L["Common.Edit"]</button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            data-confirm-url="/knn/@t.Key/@item.Id/delete"
                                            data-confirm-message="@L["Knn.Delete.Confirm"]"
                                            data-confirm-variant="danger"
                                            data-confirm-ok="@L["Common.Delete"]">@L["Common.Delete"]</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="Components/_Pagination" model="@(new PaginationViewModel { Page = Model.Pagination?.Page ?? 1, TotalPages = Model.Pagination?.TotalPages ?? 1, TotalItems = Model.Pagination?.TotalItems ?? Model.Items.Count, PageUrl = PageUrl })" />
}
