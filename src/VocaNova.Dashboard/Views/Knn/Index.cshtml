@model VocaNova.Dashboard.Models.Knn.KnnOverviewViewModel
@{
    ViewData["Title"] = "KNN Management";
    var cfg = Model.Config;
    var rb = Model.RebuildStatus;
}

<div class="page-header">
    <h1 class="page-title">KNN Management</h1>
    <p class="page-subtitle">Onboarding lookup tables and recommendation rebuild.</p>
</div>

@if (TempData["KnnSuccess"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["KnnError"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<div class="knn-cards">
    @foreach (var lookup in Model.Lookups)
    {
        <a class="knn-card" href="/knn/@lookup.Slug">
            <span class="knn-card-title">@lookup.Title</span>
            <span class="knn-card-desc">@lookup.Description</span>
        </a>
    }
</div>

<div class="chart-grid stats-grid">
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Recommendation rebuild</h2></div>
        @if (rb is null)
        {
            <p class="text-muted">Rebuild status unavailable.</p>
        }
        else
        {
            <dl class="detail-list">
                <dt>Last rebuilt</dt>
                <dd>@(rb.LastRebuildAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</dd>
                <dt>Running</dt>
                <dd>@(rb.IsRunning ? "Yes" : "No")</dd>
            </dl>
        }
        <form method="post" action="/knn/trigger-rebuild" class="inline-form js-confirm" data-confirm="Trigger a KNN recommendation rebuild now?">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-primary btn-sm">Trigger rebuild</button>
        </form>
        <p class="panel-muted" style="margin-top:10px;">Rate limited to 1 request / 5 minutes.</p>
    </section>

    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Algorithm config (read-only)</h2></div>
        @if (cfg is null)
        {
            <p class="text-muted">Config unavailable.</p>
        }
        else
        {
            <h4>Onboarding</h4>
            <dl class="detail-list">
                <dt>K value</dt><dd>@cfg.Onboarding.KValue</dd>
                <dt>Default topic limit</dt><dd>@cfg.Onboarding.DefaultTopicLimit</dd>
                <dt>Min similarity</dt><dd>@cfg.Onboarding.MinSimilarity</dd>
                <dt>Cache TTL (min)</dt><dd>@cfg.Onboarding.CacheTtlMinutes</dd>
            </dl>
            <h4 style="margin-top:14px;">Learning</h4>
            <dl class="detail-list">
                <dt>K value</dt><dd>@cfg.Learning.KValue</dd>
                <dt>Min sessions</dt><dd>@cfg.Learning.MinSessions</dd>
                <dt>Min similarity</dt><dd>@cfg.Learning.MinSimilarity</dd>
                <dt>Recommendation count</dt><dd>@cfg.Learning.RecommendationCount</dd>
                <dt>Rebuild interval (h)</dt><dd>@cfg.Learning.RebuildIntervalHours</dd>
                <dt>Cache TTL (min)</dt><dd>@cfg.Learning.CacheTtlMinutes</dd>
            </dl>
            <p class="panel-muted" style="margin-top:10px;">Change via <code>.env</code> / deployment config then restart.</p>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/knn.js" asp-append-version="true"></script>
}
