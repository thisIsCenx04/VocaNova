@model VocaNova.Dashboard.Models.Knn.KnnOverviewViewModel
@using VocaNova.Dashboard.Models.Components
@{
    ViewData["Title"] = L["Nav.Knn"];
    var cfg = Model.Config;
    var st = Model.RebuildStatus;
    string Sim(double v) => v.ToString("0.###");
}

<div class="page-header">
    <div>
        <p class="eyebrow">@L["Knn.Eyebrow"]</p>
        <h1>@L["Nav.Knn"]</h1>
    </div>
</div>

<partial name="_KnnNav" model="@("overview")" />

@* ── Rebuild status + trigger ─────────────────────────────── *@
<div class="detail-panel mb-3">
    <div class="detail-panel__header">
        <h2>@L["Knn.Rebuild.Title"]</h2>
        @if (Model.StatusLoaded && st is not null)
        {
            if (st.IsRunning)
            {
                <partial name="Components/_Badge" model="@(new BadgeViewModel { Text = L["Knn.Rebuild.Running"].Value, Modifier = "warn" })" />
            }
            else
            {
                <partial name="Components/_Badge" model="@(new BadgeViewModel { Text = L["Knn.Rebuild.Idle"].Value, Modifier = "ok" })" />
            }
        }
    </div>

    @if (!Model.StatusLoaded)
    {
        <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
    }
    else
    {
        <p style="color: var(--muted);">
            @L["Knn.Rebuild.LastAt"]:
            <strong>@(st?.LastRebuildAt is { } at ? at.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : L["Knn.Rebuild.Never"].Value)</strong>
        </p>
        <form method="post" asp-controller="Knn" asp-action="TriggerRebuild" data-knn-trigger>
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" @(st?.IsRunning == true ? "disabled" : null)>@L["Knn.Rebuild.Trigger"]</button>
        </form>
    }
</div>

@* ── Config read-only ─────────────────────────────────────── *@
@if (!Model.ConfigLoaded || cfg is null)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
}
else
{
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="detail-panel">
                <div class="detail-panel__header compact"><h2>@L["Knn.Config.Onboarding"]</h2></div>
                <dl class="kv-grid">
                    <div><dt>@L["Knn.Config.KValue"]</dt><dd class="mono">@(cfg.Onboarding?.KValue)</dd></div>
                    <div><dt>@L["Knn.Config.DefaultTopicLimit"]</dt><dd class="mono">@(cfg.Onboarding?.DefaultTopicLimit)</dd></div>
                    <div><dt>@L["Knn.Config.MinSimilarity"]</dt><dd class="mono">@(cfg.Onboarding is null ? "—" : Sim(cfg.Onboarding.MinSimilarity))</dd></div>
                    <div><dt>@L["Knn.Config.CacheTtl"]</dt><dd class="mono">@(cfg.Onboarding?.CacheTtlMinutes)</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="detail-panel">
                <div class="detail-panel__header compact"><h2>@L["Knn.Config.Learning"]</h2></div>
                <dl class="kv-grid">
                    <div><dt>@L["Knn.Config.KValue"]</dt><dd class="mono">@(cfg.Learning?.KValue)</dd></div>
                    <div><dt>@L["Knn.Config.MinSessions"]</dt><dd class="mono">@(cfg.Learning?.MinSessions)</dd></div>
                    <div><dt>@L["Knn.Config.MinSimilarity"]</dt><dd class="mono">@(cfg.Learning is null ? "—" : Sim(cfg.Learning.MinSimilarity))</dd></div>
                    <div><dt>@L["Knn.Config.RecommendationCount"]</dt><dd class="mono">@(cfg.Learning?.RecommendationCount)</dd></div>
                    <div><dt>@L["Knn.Config.RebuildInterval"]</dt><dd class="mono">@(cfg.Learning?.RebuildIntervalHours)</dd></div>
                    <div><dt>@L["Knn.Config.CacheTtl"]</dt><dd class="mono">@(cfg.Learning?.CacheTtlMinutes)</dd></div>
                </dl>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Loading state cho nút Trigger rebuild — chặn double-submit.
        document.querySelectorAll('form[data-knn-trigger]').forEach(function (f) {
            f.addEventListener('submit', function () {
                var btn = f.querySelector('button[type="submit"]');
                if (btn) { btn.disabled = true; btn.textContent = '@L["Knn.Rebuild.Triggering"]'; }
            });
        });
    </script>
}
