@model VocaNova.Dashboard.Models.Profile.ProfileViewModel
@using VocaNova.Dashboard.Models.Components
@{
    ViewData["Title"] = L["Profile.Title"];
    var p = Model.Profile;
}

<div class="page-header">
    <div>
        <p class="eyebrow">@L["Profile.Eyebrow"]</p>
        <h1>@L["Profile.Title"]</h1>
    </div>
    <a class="btn btn-secondary" href="/settings">@L["Nav.Settings"]</a>
</div>

@if (!Model.Loaded || p is null)
{
    <partial name="Components/_StateBlock" model="@(new StateBlockViewModel { State = BlockState.Error, Title = L["State.LoadError"].Value })" />
}
else
{
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="detail-panel">
                <div class="detail-panel__header compact"><h2>@L["Profile.Avatar.Title"]</h2></div>
                <div class="profile-avatar-block">
                    @if (!string.IsNullOrWhiteSpace(p.AvatarUrl))
                    {
                        <img class="profile-avatar" src="@p.AvatarUrl" alt="" />
                    }
                    else
                    {
                        <span class="profile-avatar profile-avatar--fallback">@(string.IsNullOrWhiteSpace(p.DisplayName) ? "?" : p.DisplayName[..1].ToUpperInvariant())</span>
                    }
                    <div>
                        <strong>@p.DisplayName</strong>
                        <span class="d-block" style="color: var(--muted); text-transform: capitalize;">@p.Role.Replace("_", " ")</span>
                    </div>
                </div>
                <form method="post" asp-controller="Profile" asp-action="UploadAvatar" enctype="multipart/form-data" class="mt-3">
                    @Html.AntiForgeryToken()
                    <div class="form-field mb-2">
                        <label for="avatar-file">@L["Profile.Avatar.Choose"]</label>
                        <input id="avatar-file" class="form-control" type="file" name="file" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-secondary w-100">@L["Profile.Avatar.Upload"]</button>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="detail-panel mb-3">
                <div class="detail-panel__header compact"><h2>@L["Profile.Account.Title"]</h2></div>
                <form method="post" asp-controller="Profile" asp-action="UpdateProfile">
                    @Html.AntiForgeryToken()
                    <div class="form-field mb-3">
                        <label for="display-name">@L["Profile.Field.DisplayName"]</label>
                        <input id="display-name" class="form-control" name="displayName" value="@Model.DisplayName" minlength="2" maxlength="150" required />
                    </div>
                    <dl class="kv-grid mb-3">
                        <div><dt>@L["User.Field.Phone"]</dt><dd class="mono">@(string.IsNullOrWhiteSpace(p.Phone) ? "—" : p.Phone)</dd></div>
                        <div><dt>@L["User.Field.Role"]</dt><dd>@p.Role.Replace("_", " ")</dd></div>
                        <div><dt>@L["Tbl.Status"]</dt><dd><partial name="Components/_Badge" model="@(new BadgeViewModel { Text = L["User.Status." + p.Status].Value, Modifier = BadgeModifiers.Status(p.Status) })" /></dd></div>
                    </dl>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
                    </div>
                </form>
            </div>

            <div class="detail-panel">
                <div class="detail-panel__header compact"><h2>@L["Profile.Password.Title"]</h2></div>
                <form method="post" asp-controller="Profile" asp-action="ChangePassword">
                    @Html.AntiForgeryToken()
                    <div class="form-field mb-3">
                        <label for="current-password">@L["Profile.Field.CurrentPassword"]</label>
                        <input id="current-password" type="password" class="form-control" name="currentPassword" autocomplete="current-password" required />
                    </div>
                    <div class="form-field mb-3">
                        <label for="new-password">@L["Profile.Field.NewPassword"]</label>
                        <input id="new-password" type="password" class="form-control" name="newPassword" autocomplete="new-password" required />
                        <small style="color: var(--muted);">@L["Forgot.PasswordHint"]</small>
                    </div>
                    <div class="form-field mb-3">
                        <label for="confirm-password">@L["Profile.Field.ConfirmPassword"]</label>
                        <input id="confirm-password" type="password" class="form-control" name="confirmPassword" autocomplete="new-password" required />
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">@L["Profile.Password.Change"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
