@model VocaNova.Dashboard.Models.Roles.AdminUserAssignmentViewModel
@{
    ViewData["Title"] = T["Manage User Assignments"];

    string PageUrl(int page)
    {
        var query = new List<string>();
        if (Model.SelectedAdminId.HasValue) query.Add($"adminId={Model.SelectedAdminId}");
        if (!string.IsNullOrWhiteSpace(Model.Search))
            query.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (!string.IsNullOrWhiteSpace(Model.Status)) query.Add($"status={Model.Status}");
        query.Add($"page={page}");
        return "/roles/admin-user-assignments?" + string.Join("&", query);
    }
}

<div class="admin-account-editor-shell">
    <a class="back-link" href="/roles">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>@T["Back to Role Management"]
    </a>

    <div class="page-header">
        <div>
            <h1 class="page-title">@T["Manage User Assignments"]</h1>
            <p class="page-subtitle">@T["Manage which users each administrator is allowed to access."]</p>
        </div>
    </div>

    @if (TempData["RoleSuccess"] is string success) { <div class="alert alert-success">@T[success]</div> }
    @if (TempData["RoleError"] is string error) { <div class="alert alert-danger">@T[error]</div> }

    <div class="panel assignment-panel">
        @if (Model.Assignments.Admins.Count == 0)
        {
            <p class="empty-row">@T["No administrator accounts found."]</p>
        }
        else
        {
            <form method="get" action="/roles/admin-user-assignments" class="filter-bar assignment-filter-bar">
                <select name="adminId" class="form-control select-arrow" onchange="this.form.submit()">
                    @foreach (var admin in Model.Assignments.Admins)
                    {
                        <option value="@admin.AdminId" selected="@(admin.AdminId == Model.SelectedAdminId)">
                            @admin.DisplayName (#@admin.AdminId)
                        </option>
                    }
                </select>
                <input type="text" name="search" value="@Model.Search" class="form-control"
                       placeholder="@T["Search by name, email, or user ID..."]" />
                <select name="status" class="form-control select-arrow">
                    <option value="">@T["All assignment statuses"]</option>
                    <option value="assigned" selected="@(Model.Status == "assigned")">
                        @T["Assigned to selected administrator"]
                    </option>
                    <option value="unassigned" selected="@(Model.Status == "unassigned")">
                        @T["Not assigned"]
                    </option>
                    <option value="other" selected="@(Model.Status == "other")">
                        @T["Assigned to another administrator"]
                    </option>
                </select>
                <button type="submit" class="btn-primary">@T["Filter"]</button>
                <a class="btn-secondary"
                   href="/roles/admin-user-assignments?adminId=@Model.SelectedAdminId">@T["Reset"]</a>
            </form>

            <form method="post" action="/roles/admin-user-assignments" class="assignment-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="adminId" value="@Model.SelectedAdminId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="status" value="@Model.Status" />
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="assignment-grid">
                    @foreach (var user in Model.Users)
                    {
                        var checkedForAdmin = user.AssignedAdminId == Model.SelectedAdminId;
                        var assignedElsewhere = user.AssignedAdminId.HasValue && !checkedForAdmin;
                        var otherAdmin = assignedElsewhere
                            ? Model.Assignments.Admins.FirstOrDefault(item => item.AdminId == user.AssignedAdminId)
                            : null;
                        <input type="hidden" name="visibleUserIds" value="@user.UserId" />
                        <label class="assignment-card @(assignedElsewhere ? "is-unavailable" : null)">
                            <input type="checkbox" name="userIds" value="@user.UserId"
                                   checked="@checkedForAdmin" disabled="@assignedElsewhere" />
                            <span>
                                <strong>@user.DisplayName</strong>
                                <small>#@user.UserId · @(user.Email ?? "—")</small>
                                @if (otherAdmin is not null)
                                {
                                    <small class="text-warning">@T["Already assigned to"]: @otherAdmin.DisplayName</small>
                                }
                            </span>
                        </label>
                    }
                </div>
                @if (Model.Users.Count == 0)
                {
                    <p class="empty-row">@T["No user accounts found."]</p>
                }
                <div class="admin-account-form-actions">
                    <button type="submit" class="btn-primary">@T["Save Assignments"]</button>
                </div>
            </form>

            <div class="assignment-results-footer">
                <span class="pager-info">@Model.TotalUsers @T["user(s) found."]</span>
                @if (Model.TotalPages > 1)
                {
                    var windowStart = Math.Max(1, Model.Page - 2);
                    var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
                    windowStart = Math.Max(1, windowEnd - 4);
                    <nav class="pager" aria-label="@T["Pagination"]">
                        @if (Model.Page > 1)
                        {
                            <a class="pager-link" href="@PageUrl(Model.Page - 1)">← @T["Prev"]</a>
                        }
                        else
                        {
                            <span class="pager-link disabled">← @T["Prev"]</span>
                        }
                        @for (var pageNumber = windowStart; pageNumber <= windowEnd; pageNumber++)
                        {
                            <a class="pager-link @(pageNumber == Model.Page ? "active" : null)"
                               href="@PageUrl(pageNumber)">@pageNumber</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a class="pager-link" href="@PageUrl(Model.Page + 1)">@T["Next"] →</a>
                        }
                        else
                        {
                            <span class="pager-link disabled">@T["Next"] →</span>
                        }
                    </nav>
                }
            </div>
        }
    </div>
</div>
