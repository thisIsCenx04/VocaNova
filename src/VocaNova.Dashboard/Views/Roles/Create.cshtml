@model VocaNova.Dashboard.Models.Roles.SaveRoleViewModel
@{
    ViewData["Title"] = T["Create Role"];
}

<div class="admin-account-editor-shell">
    <a class="btn-primary page-back-button" href="/roles">@T["Back"]</a>

    <div class="page-header">
        <div>
            <h1 class="page-title">@T["Create Role"]</h1>
        </div>
    </div>

    <form method="post" action="/roles/create" class="panel admin-account-form">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger validation-summary">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                    {
                        <li>@T[error.ErrorMessage]</li>
                    }
                </ul>
            </div>
        }

        <div class="form-group">
            <label asp-for="RoleName">@T["Role Name"] <span class="req">*</span></label>
            <input asp-for="RoleName" class="form-control" autocomplete="off" autofocus
                   placeholder="@T["Example: content_manager"]" />
            <small class="form-help">@T["Use lowercase letters, numbers, and underscores only."]</small>
        </div>

        <div class="admin-account-form-actions">
            <a href="/roles" class="btn-secondary">@T["Cancel"]</a>
            <button type="submit" class="btn-primary">@T["Create Role"]</button>
        </div>
    </form>
</div>
