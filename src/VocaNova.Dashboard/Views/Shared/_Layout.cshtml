@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirstValue(ClaimTypes.Name) ?? "Admin";
    var avatarFallback = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName[..1].ToUpperInvariant();
    var role = User.FindFirstValue(ClaimTypes.Role) ?? User.FindFirstValue("role") ?? string.Empty;
    var avatarUrl = User.FindFirstValue("avatar_url");
    // Role-based sidebar: chỉ super_admin thấy các mục quản trị tài khoản admin (F055).
    var isSuperAdmin = string.Equals(role, "super_admin", StringComparison.Ordinal);

    // Xác định mục đang active để tô đậm trên sidebar.
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    string NavActive(string prefix) =>
        (prefix == "/" ? path == "/" || path.StartsWith("/dashboard") : path.StartsWith(prefix))
            ? "sidebar-link active"
            : "sidebar-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VocaNova Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="app-shell">
            <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle" aria-label="Toggle navigation" />
            <aside class="sidebar" aria-label="Primary navigation">
                <div class="sidebar-brand">
                    <span class="brand-mark">VN</span>
                    <span>VocaNova</span>
                </div>

                <nav class="sidebar-nav">
                    <a class="@NavActive("/")" asp-controller="Dashboard" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-16v5h6V4h-6Z" /></svg>
                        <span>Dashboard</span>
                    </a>
                    <a class="@NavActive("/vocabulary")" href="/vocabulary">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h10a4 4 0 0 1 4 4v12H8a3 3 0 0 1-3-3V4Zm3 14h9V8a2 2 0 0 0-2-2H7v11a1 1 0 0 0 1 1Zm1-9h6v2H9V9Zm0 4h5v2H9v-2Z" /></svg>
                        <span>Vocabulary</span>
                    </a>
                    <a class="@NavActive("/topics")" href="/topics">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v4H4V5Zm0 6h7v8H4v-8Zm9 0h7v8h-7v-8Z" /></svg>
                        <span>Topics</span>
                    </a>
                    <a class="@NavActive("/statistics")" href="/statistics">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V8h3v12H5Zm6 0V4h3v16h-3Zm6 0v-9h3v9h-3Z" /></svg>
                        <span>Statistics</span>
                    </a>
                    <a class="@NavActive("/users")" href="/users">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 1 1 16 0H4Z" /></svg>
                        <span>Users</span>
                    </a>
                    <a class="@NavActive("/knn")" href="/knn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-4.7-11.3 3.3 3.3 1.4-1.4-3.3-3.3-1.4 1.4Zm9.4 0-3.3 3.3 1.4 1.4 3.3-3.3-1.4-1.4Z" /></svg>
                        <span>KNN Management</span>
                    </a>
                    @if (isSuperAdmin)
                    {
                        <a class="@NavActive("/admin-accounts")" href="/admin-accounts">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 9a7 7 0 0 1 14 0H5Zm15-9h2v3h-2v2h-3v-2h-2v-3h2v-2h3v2Z" /></svg>
                            <span>Admin Accounts</span>
                        </a>
                    }
                </nav>
            </aside>

            <div class="content-shell">
                <header class="topbar">
                    <label class="icon-button" for="sidebar-toggle" aria-label="Toggle navigation">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z" /></svg>
                    </label>

                    <div class="account-summary">
                        <div class="account-link">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="" />
                            }
                            else
                            {
                                <span class="account-avatar">@avatarFallback</span>
                            }
                            <div>
                                <span class="account-name">@displayName</span>
                                <span class="account-role">@role.Replace("_", " ")</span>
                            </div>
                        </div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-button" aria-label="Sign out" title="Sign out">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4h10v16H10v-2h8V6h-8V4Zm1 4 5 4-5 4v-3H4v-2h7V8Z" /></svg>
                            </button>
                        </form>
                    </div>
                </header>

                <main class="main-content" role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="auth-shell" role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
