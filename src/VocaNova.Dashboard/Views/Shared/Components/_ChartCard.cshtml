@model ChartCardViewModel
@* Khung chart. Page tự init Chart.js trên canvas (#@Model.CanvasId) trong @@section Scripts,
   và nhớ include <script src="~/lib/chart/chart.umd.min.js"></script> (xem libman.json). *@
<div class="chart-card">
    <header>
        <h2>@Model.Title</h2>
        @if (Model.ShowGranularity)
        {
            <select class="form-select" data-chart-granularity="@Model.CanvasId" style="max-width: 160px;">
                <option value="daily">@L["Chart.Daily"]</option>
                <option value="weekly">@L["Chart.Weekly"]</option>
                <option value="monthly">@L["Chart.Monthly"]</option>
            </select>
        }
    </header>
    <div class="chart-canvas-wrap">
        <canvas id="@Model.CanvasId"></canvas>
    </div>
</div>
