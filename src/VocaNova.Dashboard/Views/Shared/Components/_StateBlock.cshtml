@model StateBlockViewModel
@if (Model.State == BlockState.Loading)
{
    <div class="state-block" aria-busy="true">
        @for (var i = 0; i < Model.SkeletonRows; i++)
        {
            <div class="skeleton skeleton-row"></div>
        }
    </div>
}
else
{
    <div class="state-block">
        @if (!string.IsNullOrEmpty(Model.Title))
        {
            <h2>@Model.Title</h2>
        }
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p>@Model.Message</p>
        }
        @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionUrl))
        {
            <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
        }
    </div>
}
