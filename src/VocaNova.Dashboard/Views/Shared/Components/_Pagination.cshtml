@model PaginationViewModel
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    var prevDisabled = Model.Page <= 1;
    var nextDisabled = Model.Page >= Model.TotalPages;

    <div class="pagination-bar">
        <span class="pagination-info">@Model.TotalItems · @Model.Page / @Model.TotalPages</span>
        <div class="pages">
            <a class="page-btn" href="@Model.PageUrl(Model.Page - 1)" aria-disabled="@prevDisabled.ToString().ToLowerInvariant()" aria-label="Previous">‹</a>
            @if (start > 1)
            {
                <a class="page-btn" href="@Model.PageUrl(1)">1</a>
                @if (start > 2)
                {
                    <span class="page-btn" aria-disabled="true">…</span>
                }
            }
            @for (var p = start; p <= end; p++)
            {
                <a class="page-btn @(p == Model.Page ? "is-active" : null)" href="@Model.PageUrl(p)">@p</a>
            }
            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1)
                {
                    <span class="page-btn" aria-disabled="true">…</span>
                }
                <a class="page-btn" href="@Model.PageUrl(Model.TotalPages)">@Model.TotalPages</a>
            }
            <a class="page-btn" href="@Model.PageUrl(Model.Page + 1)" aria-disabled="@nextDisabled.ToString().ToLowerInvariant()" aria-label="Next">›</a>
        </div>
    </div>
}
