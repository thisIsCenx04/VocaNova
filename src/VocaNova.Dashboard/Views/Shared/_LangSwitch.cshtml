@using System.Globalization
@{
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi" ? "vi" : "en";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<details class="lang-switch">
    <summary class="icon-button" aria-label="@L["Lang.Label"]" title="@L["Lang.Label"]">
        <span class="lang-code">@(current == "vi" ? "VI" : "EN")</span>
    </summary>
    <div class="lang-menu">
        <form asp-controller="Culture" asp-action="Set" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="culture" value="en" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="lang-option @(current == "en" ? "is-active" : "")">@L["Lang.English"]</button>
        </form>
        <form asp-controller="Culture" asp-action="Set" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="culture" value="vi" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="lang-option @(current == "vi" ? "is-active" : "")">@L["Lang.Vietnamese"]</button>
        </form>
    </div>
</details>
