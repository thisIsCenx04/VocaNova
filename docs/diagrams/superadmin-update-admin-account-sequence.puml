@startuml
title Update Admin Account Sequence (/api/superadmin/admins/{id})

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor SuperAdmin
boundary "Edit Admin Account\nPage (Dashboard)" as EditPage
control "AdminAccountsController\n(Dashboard)" as DashboardController
control "ServiceAPI\n(Dashboard)" as ServiceApi
entity "UpdateAdminAccountRequest /\nAdminAccountResponse\n(Request/Response DTO)" as AdminAccountDto
control "SuperAdminAccountsController\n(API)" as ApiController
control "SuperAdminAccountService" as AccountService
control "SuperAdminAccountRepository" as AccountRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over EditPage, MySQL
Checked in current code:
Dashboard AdminAccountsController posts edit data through ServiceAPI.
API uses UpdateAdminAccountRequest and returns AdminAccountResponse.
If password is changed or status becomes locked, active refresh tokens are revoked.
end note

SuperAdmin -> EditPage: Open edit admin page
EditPage -> DashboardController: GET /admin-accounts/{id}/edit
DashboardController -> ServiceApi: GetAdminAccountAsync(id)
ServiceApi -> ApiController: GET /api/superadmin/admins/{id}
ApiController -> AccountService: GetAccountAsync(id)
AccountService -> AccountRepository: GetAccountAsync(id)
AccountRepository -> DbContext: Query admin account
DbContext -> MySQL: SELECT admin account
MySQL --> DbContext: Admin account row or null
DbContext --> AccountRepository: Result
AccountRepository --> AccountService: Admin account or null

alt Admin account not found or deleted
    AccountService --> ApiController: NotFound result
    ApiController --> ServiceApi: HTTP 404 error
    ServiceApi --> DashboardController: null
    DashboardController --> EditPage: Show not found
else Admin account found
    AccountService --> ApiController: Return admin account
    ApiController -> AdminAccountDto: Create response data\n(AdminAccountResponse)
    AdminAccountDto --> ServiceApi: HTTP 200 OK\nAdminAccountResponse
    ServiceApi --> DashboardController: Admin account
    DashboardController --> EditPage: Render edit form
end

SuperAdmin -> EditPage: Update full name, email,\nphone, password?, status
SuperAdmin -> EditPage: Submit form
EditPage -> DashboardController: POST /admin-accounts/{id}/edit
DashboardController -> DashboardController: Validate form input

alt Form input invalid
    DashboardController --> EditPage: Show validation message
else Form input valid
    DashboardController -> ServiceApi: UpdateAdminAccountAsync(id, input)
    ServiceApi -> AdminAccountDto: Create request data\n(full_name, email, phone,\npassword?, status)
    AdminAccountDto -> ApiController: PUT /api/superadmin/admins/{id}\nUpdateAdminAccountRequest
    ApiController -> ApiController: Check super admin authorization
    ApiController -> ApiController: Validate UpdateAdminAccountRequest

    alt Request validation fails
        ApiController --> ServiceApi: HTTP 400 error
        ServiceApi --> DashboardController: Action failed
        DashboardController --> EditPage: Show error message
    else Request validation success
        ApiController -> AccountService: UpdateAsync(id, update data)
        AccountService -> AccountRepository: FindDuplicateAsync(phone, email, id)
        AccountRepository -> DbContext: Query duplicate phone/email
        DbContext -> MySQL: SELECT user_auth
        MySQL --> DbContext: Duplicate row or null
        DbContext --> AccountRepository: Result
        AccountRepository --> AccountService: Duplicate message or null

        alt Phone or email already exists
            AccountService --> ApiController: Conflict result
            ApiController --> ServiceApi: HTTP 409 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> EditPage: Show error message
        else Phone and email are available
            AccountService -> AccountRepository: GetAccountStatusAsync(id)
            AccountRepository -> DbContext: Query current admin status
            DbContext -> MySQL: SELECT user status
            MySQL --> DbContext: Status row or null
            DbContext --> AccountRepository: Result
            AccountRepository --> AccountService: status or null

            alt Admin account not found or deleted
                AccountService --> ApiController: NotFound result
                ApiController --> ServiceApi: HTTP 404 error
                ServiceApi --> DashboardController: Action failed
                DashboardController --> EditPage: Show error message
            else Admin account can be updated
                AccountService -> AccountService: Hash password if supplied\nand begin transaction

                opt Password changed or status becomes locked
                    AccountService -> AccountRepository: RevokeActiveRefreshTokensAsync(id)
                    AccountRepository -> DbContext: Revoke active refresh tokens
                    DbContext -> MySQL: UPDATE refresh_tokens
                    MySQL --> DbContext: Update result
                end

                AccountService -> AccountRepository: UpdateAccountAsync(id, update data)
                AccountRepository -> DbContext: Update User, UserAuth, UserProfile
                DbContext -> MySQL: UPDATE admin account data
                MySQL --> DbContext: Update result
                DbContext --> AccountRepository: Save result
                AccountRepository --> AccountService: Updated admin account
                AccountService --> ApiController: Return updated account
                ApiController -> AdminAccountDto: Create response data\n(AdminAccountResponse)
                AdminAccountDto --> ServiceApi: HTTP 200 OK\nAdminAccountResponse
                ServiceApi --> DashboardController: Action success
                DashboardController --> EditPage: Redirect to admin account list
            end
        end
    end
end

@enduml
