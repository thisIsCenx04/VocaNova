@startuml
title Update Admin Account Sequence (/api/superadmin/admins/{id})
autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
actor SuperAdmin
boundary "Edit Admin Account UI" as EditPage
control "AdminAccountsController\n(FE Dashboard)" as FeController
control "SuperAdminAccountsController\n(BE API)" as BeController
entity "AdminAccount\n(FE Response DTO)" as FeResponseDto
entity "UpdateAdminAccountRequest\n(BE Request DTO)" as BeRequestDto
entity "AdminAccountResponse\n(BE Response DTO)" as BeResponseDto
control "ISuperAdminAccountService" as ISuperAdminAccountService
control "SuperAdminAccountService" as AccountService
entity "User" as UserEntity
entity "UserAuth" as UserAuthEntity
entity "UserProfile" as UserProfileEntity
entity "RefreshToken" as RefreshTokenEntity
control "ISuperAdminAccountRepository" as ISuperAdminAccountRepository
control "SuperAdminAccountRepository" as AccountRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL
note over EditPage, MySQL
Checked in current code:
Dashboard UI file exists: Views/AdminAccounts/Edit.cshtml.
FE controller exists: AdminAccountsController.
FE response DTO exists: Dashboard Data/Dtos/SuperAdmin/AdminAccount.
BE controller exists: SuperAdminAccountsController.
BE DTOs exist: UpdateAdminAccountRequest and AdminAccountResponse.
Entities exist: User, UserAuth, UserProfile and RefreshToken.
Dashboard calls API through VocaNovaApiClient.GetAdminAccountAsync and UpdateAdminAccountAsync.
Interfaces used in code: ISuperAdminAccountService, ISuperAdminAccountRepository.
end note
SuperAdmin -> EditPage: Open edit admin page
EditPage -> FeController: GET /admin-accounts/{id}/edit
FeController -> BeController: VocaNovaApiClient.GetAdminAccountAsync\nGET /api/superadmin/admins/{id}
BeController -> ISuperAdminAccountService: GetAccountAsync(id)
ISuperAdminAccountService -> AccountService: GetAccountAsync(id)
AccountService -> ISuperAdminAccountRepository: GetAccountAsync(id)
ISuperAdminAccountRepository -> AccountRepository: GetAccountAsync(id)
AccountRepository -> DbContext: Query admin account
DbContext -> MySQL: SELECT users with auth/profile/role
MySQL --> DbContext: Admin account row or null
DbContext --> AccountRepository: Result
AccountRepository --> AccountService: Admin account or null
alt Admin account not found or deleted
    AccountService --> BeController: NotFound result
    BeController --> FeController: HTTP 404 error
    FeController --> EditPage: Show not found
else Admin account found
    AccountService --> BeController: Admin account result
    BeController -> BeResponseDto: Create AdminAccountResponse
    BeResponseDto --> BeController: AdminAccountResponse
    BeController -> FeResponseDto: HTTP 200 OK\nAdminAccountResponse JSON
    FeResponseDto --> FeController: AdminAccount
end
SuperAdmin -> EditPage: Update full name, email,\nphone, password?, status
SuperAdmin -> EditPage: Submit form
EditPage -> FeController: POST /admin-accounts/{id}/edit\nEditAdminAccountViewModel
FeController -> FeController: Validate id, ModelState\nand status
alt Form input invalid
    FeController --> EditPage: Return Edit.cshtml\nwith validation errors
else Form input valid
    FeController -> BeController: VocaNovaApiClient.UpdateAdminAccountAsync\nPUT /api/superadmin/admins/{id}
    BeController -> BeRequestDto: Bind JSON body
    BeRequestDto --> BeController: UpdateAdminAccountRequest
    BeController -> BeController: Check super admin authorization
    BeController -> BeController: Validate UpdateAdminAccountRequest
    alt Request validation fails
        BeController --> FeController: HTTP 400 error
        FeController --> EditPage: Return Edit.cshtml\nwith error message
    else Request validation success
        BeController -> ISuperAdminAccountService: UpdateAsync(id, update data)
        ISuperAdminAccountService -> AccountService: UpdateAsync(id, update data)
        AccountService -> ISuperAdminAccountRepository: FindDuplicateAsync(phone, email, id)
        ISuperAdminAccountRepository -> AccountRepository: FindDuplicateAsync(phone, email, id)
        AccountRepository -> DbContext: Query UserAuth
        DbContext -> MySQL: SELECT user_auth
        MySQL --> DbContext: Duplicate row or null
        DbContext --> AccountRepository: Result
        AccountRepository --> AccountService: Duplicate message or null
        alt Phone or email already exists
            AccountService --> BeController: Conflict result
            BeController --> FeController: HTTP 409 error
            FeController --> EditPage: Return Edit.cshtml\nwith error message
        else Phone and email are available
            AccountService -> ISuperAdminAccountRepository: GetAccountStatusAsync(id)
            ISuperAdminAccountRepository -> AccountRepository: GetAccountStatusAsync(id)
            AccountRepository -> DbContext: Query User status
            DbContext -> MySQL: SELECT users
            MySQL --> DbContext: Status row or null
            DbContext --> AccountRepository: status or null
            alt Admin account not found or deleted
                AccountService --> BeController: NotFound result
                BeController --> FeController: HTTP 404 error
                FeController --> EditPage: Return Edit.cshtml\nwith error message
            else Admin account can be updated
                AccountService -> ISuperAdminAccountService: Hash password if supplied\nand begin transaction
                ISuperAdminAccountService -> AccountService: Hash password if supplied\nand begin transaction
                opt Password changed or status becomes locked
                    AccountService -> ISuperAdminAccountRepository: RevokeActiveRefreshTokensAsync(id)
                    ISuperAdminAccountRepository -> AccountRepository: RevokeActiveRefreshTokensAsync(id)
                    AccountRepository -> RefreshTokenEntity: Set RevokedAt
                    RefreshTokenEntity --> AccountRepository: RefreshToken updated
                    AccountRepository -> DbContext: Track refresh token updates
                    DbContext -> MySQL: UPDATE refresh_tokens
                    MySQL --> DbContext: Update result
                end
                AccountService -> ISuperAdminAccountRepository: UpdateAccountAsync(id, update data)
                ISuperAdminAccountRepository -> AccountRepository: UpdateAccountAsync(id, update data)
                AccountRepository -> DbContext: Find admin account
                DbContext -> MySQL: SELECT users with auth/profile/role
                MySQL --> DbContext: Admin account row or null
                DbContext --> AccountRepository: Result
                alt Admin account disappeared
                    AccountRepository --> AccountService: null
                    AccountService --> BeController: NotFound result
                    BeController --> FeController: HTTP 404 error
                    FeController --> EditPage: Return Edit.cshtml\nwith error message
                else Admin account found
                    AccountRepository -> UserEntity: Update status
                    AccountRepository -> UserAuthEntity: Update phone, email,\npassword_hash?
                    AccountRepository -> UserProfileEntity: Update full_name
                    UserEntity --> AccountRepository: User
                    UserAuthEntity --> AccountRepository: UserAuth
                    UserProfileEntity --> AccountRepository: UserProfile
                    AccountRepository -> DbContext: Track User entity graph
                    DbContext -> MySQL: UPDATE users,\nuser_auth, user_profiles
                    MySQL --> DbContext: Update result
                    DbContext --> AccountRepository: Tracking state
                    AccountRepository --> AccountService: Updated admin account
                    AccountService -> ISuperAdminAccountService: Save changes\nand commit transaction
                    ISuperAdminAccountService -> AccountService: Save changes\nand commit transaction
                    AccountService --> BeController: Updated admin result
                    BeController -> BeResponseDto: Create AdminAccountResponse
                    BeResponseDto --> BeController: AdminAccountResponse
                    BeController --> FeController: HTTP 200 OK\nAdminAccountResponse
                    FeController --> EditPage: Redirect to admin account list
                end
            end
        end
    end
end
@enduml
