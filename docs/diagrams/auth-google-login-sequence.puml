@startuml
title Login With Google Sequence (/api/auth/google)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor Guest
boundary "Login\nPage" as LoginPage
control "Google\nService" as GoogleService
entity "Google Login\nDTO" as GoogleLoginDto
control "Auth\nController" as AuthController
control "Auth\nService" as AuthService
control "Auth\nRepository" as AuthRepository
database "VocaNovaDb\nContext" as DbContext
database "MySQL\nDatabase" as MySQL

Guest -> LoginPage: Access login page
Guest -> LoginPage: Click Login with Google
LoginPage -> GoogleService: Login with Google
GoogleService --> LoginPage: id_token

alt Google login cancelled or token missing
    LoginPage --> Guest: Show error message
else Google token received
    LoginPage -> GoogleLoginDto: Create Google login DTO\n(id_token)
    LoginPage -> AuthController: POST /api/auth/google\nGoogle Login DTO
    AuthController -> AuthController: Validate Google login request

    alt Request validation or rate limit fails
        AuthController --> LoginPage: HTTP 400/429 error
        LoginPage --> Guest: Show error message
    else Request validation success
        AuthController -> AuthService: GoogleLoginAsync(login data)
        AuthService -> GoogleService: Verify id_token
        GoogleService --> AuthService: Google user info or null

        alt id_token invalid
            AuthService --> AuthController: Unauthorized result
            AuthController --> LoginPage: HTTP 401 Invalid Google id token
            LoginPage --> Guest: Show error message
        else id_token valid
            AuthService -> AuthRepository: FindByGoogleSubjectAsync(subject)
            AuthRepository -> DbContext: Query user by Google subject
            DbContext -> MySQL: SELECT user account
            MySQL --> DbContext: User row or null
            DbContext --> AuthRepository: Result
            AuthRepository --> AuthService: AuthAccount or null

            alt Existing Google account
                alt Account locked or deleted
                    AuthService --> AuthController: Forbidden/Unauthorized result
                    AuthController --> LoginPage: HTTP 403/401 error
                    LoginPage --> Guest: Show error message
                else Account active
                    AuthService -> AuthRepository: Update last login
                    AuthRepository -> DbContext: Update User.LastLoginAt
                    DbContext -> MySQL: UPDATE users
                    MySQL --> DbContext: Update result

                    AuthService -> AuthRepository: Create refresh token
                    AuthRepository -> DbContext: Add RefreshToken
                    DbContext -> MySQL: INSERT refresh_tokens
                    MySQL --> DbContext: Insert result

                    AuthService --> AuthController: Return login result
                    AuthController --> LoginPage: HTTP 200 OK
                    LoginPage --> Guest: Navigate to app
                end
            else New Google account
                AuthService -> AuthRepository: FindByGoogleEmailAsync(email)
                AuthRepository -> DbContext: Query user by Google email
                DbContext -> MySQL: SELECT user account
                MySQL --> DbContext: User row or null
                DbContext --> AuthRepository: Result
                AuthRepository --> AuthService: AuthAccount or null

                alt Google email already exists
                    AuthService --> AuthController: Conflict result
                    AuthController --> LoginPage: HTTP 409 Google email already exists
                    LoginPage --> Guest: Show error message
                else Email is available
                    AuthService -> AuthRepository: FindRoleByNameAsync("User")
                    AuthRepository -> DbContext: Query role
                    DbContext -> MySQL: SELECT roles
                    MySQL --> DbContext: Role row or null
                    DbContext --> AuthRepository: Result
                    AuthRepository --> AuthService: AuthRole or null

                    alt Default user role missing
                        AuthService --> AuthController: Validation failure
                        AuthController --> LoginPage: HTTP 400 error
                        LoginPage --> Guest: Show error message
                    else Role exists
                        AuthService -> AuthRepository: Create Google user account
                        AuthRepository -> DbContext: Add User, UserAuth,\nUserProfile
                        DbContext -> MySQL: INSERT account data
                        MySQL --> DbContext: Insert result
                        DbContext --> AuthRepository: Save result

                        AuthService -> AuthRepository: Reload created account
                        AuthRepository -> DbContext: Query user by Google subject
                        DbContext -> MySQL: SELECT created user account
                        MySQL --> DbContext: Created user row
                        DbContext --> AuthRepository: Result
                        AuthRepository --> AuthService: Created account

                        AuthService -> AuthRepository: Create refresh token
                        AuthRepository -> DbContext: Add RefreshToken
                        DbContext -> MySQL: INSERT refresh_tokens
                        MySQL --> DbContext: Insert result
                        DbContext --> AuthRepository: Save result

                        AuthService --> AuthController: Return login result
                        AuthController --> LoginPage: HTTP 200 OK
                        LoginPage --> Guest: Navigate to app
                    end
                end
            end
        end
    end
end

@enduml
