@startuml
title Retry Incorrect Vocabulary Sequence (/api/quiz/wrong-words and /api/quiz/sessions)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor Learner
boundary "Retry Incorrect Vocabulary UI" as RetryIncorrectUi
control "WrongWordsNotifier\n(FE Controller)" as WrongWordsController
control "QuizConfigNotifier\n(FE Controller)" as QuizConfigController
entity "WrongWordsRequest\n(BE Request DTO)" as BeWrongWordsRequestDto
entity "WrongWordResponse\n(BE Response DTO)" as BeWrongWordResponseDto
entity "CreateSessionRequest\n(BE Request DTO)" as BeCreateSessionDto
entity "CreateSessionResponse\n(BE Response DTO)" as BeCreateSessionResponseDto
entity "QuestionResponse\n(BE Response DTO)" as BeQuestionDto
control "QuizSessionsController\n(BE API)" as BeController
control "IQuizHistoryService" as IQuizHistoryService
control "QuizHistoryService" as HistoryService
control "IQuizSessionService" as IQuizSessionService
control "QuizSessionService" as SessionService
control "IQuizSessionBuilder" as IQuizSessionBuilder
control "QuizSessionBuilder" as SessionBuilder
control "IQuizQuestionBuilder" as IQuizQuestionBuilder
control "QuizQuestionBuilder" as QuestionBuilder
entity "UserWordProgress" as UserWordProgressEntity
entity "Word" as WordEntity
entity "WordSense" as WordSenseEntity
entity "TestSession" as TestSessionEntity
control "IQuizHistoryRepository" as IQuizHistoryRepository
control "QuizHistoryRepository" as HistoryRepository
control "IQuizPoolRepository" as IQuizPoolRepository
control "QuizPoolRepository" as PoolRepository
control "IQuizQuestionRepository" as IQuizQuestionRepository
control "QuizQuestionRepository" as QuestionRepository
control "IQuizSessionRepository" as IQuizSessionRepository
control "QuizSessionRepository" as SessionRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over RetryIncorrectUi, MySQL
Checked in current code:
Mobile UI file exists: wrong_words_screen.dart.
FE controllers exist: WrongWordsNotifier and QuizConfigNotifier.
BE controller exists: QuizSessionsController.
BE DTOs exist: WrongWordsRequest, WrongWordResponse,
CreateSessionRequest, CreateSessionResponse and QuestionResponse.
Retry incorrect vocabulary is implemented by creating a quiz session with scope_type = "wrong_words".
Entities exist: UserWordProgress, Word, WordSense and TestSession.
Interfaces used in code: IQuizHistoryService, IQuizSessionService, IQuizSessionBuilder,
  IQuizQuestionBuilder, IQuizHistoryRepository,
  IQuizPoolRepository, IQuizQuestionRepository,
  IQuizSessionRepository.
end note

Learner -> RetryIncorrectUi: Open incorrect vocabulary list
RetryIncorrectUi -> WrongWordsController: loadFirstPage()
WrongWordsController -> BeController: GET /api/quiz/wrong-words\npage, limit
BeController -> BeWrongWordsRequestDto: Bind query string
BeWrongWordsRequestDto --> BeController: WrongWordsRequest
BeController -> BeController: Check authenticated user
BeController -> IQuizHistoryService: GetWrongWordsAsync(userId, query)
IQuizHistoryService -> HistoryService: GetWrongWordsAsync(userId, query)
HistoryService -> IQuizHistoryRepository: GetWrongWordsAsync(userId, page, limit)
IQuizHistoryRepository -> HistoryRepository: GetWrongWordsAsync(userId, page, limit)
HistoryRepository -> DbContext: Query wrong word progress
DbContext -> MySQL: SELECT user_word_progresses\nJOIN words and word_senses
MySQL --> DbContext: Wrong word rows
DbContext -> UserWordProgressEntity: Read UserWordProgress rows
DbContext -> WordEntity: Read Word rows
DbContext -> WordSenseEntity: Read primary WordSense rows
UserWordProgressEntity --> DbContext: Progress rows
WordEntity --> DbContext: Word rows
WordSenseEntity --> DbContext: Meaning rows
DbContext --> HistoryRepository: Paged wrong words
HistoryRepository --> HistoryService: Paged wrong words
HistoryService --> BeController: Wrong words result
BeController -> BeWrongWordResponseDto: Create WrongWordResponse list
BeWrongWordResponseDto --> BeController: WrongWordResponse list
BeController --> WrongWordsController: HTTP 200 OK\nWrongWordResponse list
WrongWordsController --> RetryIncorrectUi: Show incorrect vocabulary

Learner -> RetryIncorrectUi: Choose retry incorrect words
RetryIncorrectUi -> QuizConfigController: setScope("wrong_words")\nand createSession()
QuizConfigController -> BeController: POST /api/quiz/sessions\nscope_type = "wrong_words"
BeController -> BeCreateSessionDto: Bind request body
BeCreateSessionDto --> BeController: CreateSessionRequest
BeController -> BeController: Check authenticated user
BeController -> BeController: Validate CreateSessionRequest

alt Request invalid
    BeController --> QuizConfigController: HTTP 400 error
    QuizConfigController --> RetryIncorrectUi: Show create quiz error
else Request valid
    BeController -> IQuizSessionService: CreateSessionAsync(userId, command)
    IQuizSessionService -> SessionService: CreateSessionAsync(userId, command)
    SessionService -> IQuizSessionBuilder: BuildPoolAsync(userId, command)
    IQuizSessionBuilder -> SessionBuilder: BuildPoolAsync(userId, command)
    SessionBuilder -> IQuizPoolRepository: GetCandidatesAsync(userId,\nscope_type = "wrong_words")
    IQuizPoolRepository -> PoolRepository: GetCandidatesAsync(userId,\nscope_type = "wrong_words")
    PoolRepository -> DbContext: Query words in wrong list
    DbContext -> MySQL: SELECT words JOIN word_senses\nWHERE user_word_progresses.is_in_wrong_list
    MySQL --> DbContext: Candidate rows
    DbContext -> UserWordProgressEntity: Read wrong-list progress
    DbContext -> WordEntity: Read Word rows
    DbContext -> WordSenseEntity: Read WordSense rows
    UserWordProgressEntity --> DbContext: Wrong-list filter
    WordEntity --> DbContext: Candidate words
    WordSenseEntity --> DbContext: Candidate answers
    DbContext --> PoolRepository: Candidate words
    PoolRepository --> SessionBuilder: Candidate pool
    SessionBuilder --> SessionService: Pool result

    alt No incorrect vocabulary available
        SessionService -> SessionService: Check empty pool
        SessionService --> BeController: Validation failure
        BeController --> QuizConfigController: HTTP 400 error
        QuizConfigController --> RetryIncorrectUi: Show no words message
    else Candidates available
        SessionService -> IQuizQuestionBuilder: BuildQuestionAsync(wordId, questionType)
        IQuizQuestionBuilder -> QuestionBuilder: BuildQuestionAsync(wordId, questionType)
        QuestionBuilder -> IQuizQuestionRepository: FindQuestionWordAsync(wordId)
        IQuizQuestionRepository -> QuestionRepository: FindQuestionWordAsync(wordId)
        QuestionRepository -> DbContext: Query Word with senses
        DbContext -> MySQL: SELECT words,\nword_senses
        MySQL --> DbContext: Question word rows
        DbContext -> WordEntity: Read Word
        DbContext -> WordSenseEntity: Read WordSense
        WordEntity --> DbContext: Question word
        WordSenseEntity --> DbContext: Expected answer
        DbContext --> QuestionRepository: Question word
        QuestionRepository --> QuestionBuilder: Question data
        QuestionBuilder --> SessionService: First question
        SessionService -> IQuizSessionRepository: CreateAsync(userId, command, topicIds, questionCount)
        IQuizSessionRepository -> SessionRepository: CreateAsync(userId, command, topicIds, questionCount)
        SessionRepository -> TestSessionEntity: Create TestSession
        TestSessionEntity --> SessionRepository: TestSession
        SessionRepository -> DbContext: Add TestSession
        DbContext -> MySQL: INSERT test_sessions
        MySQL --> DbContext: Insert result
        DbContext --> SessionRepository: Save result
        SessionRepository --> SessionService: Created session
        SessionService -> SessionService: Build created session result
        SessionService --> BeController: Created session result
        BeController -> BeCreateSessionResponseDto: Create CreateSessionResponse
        BeCreateSessionResponseDto --> BeController: CreateSessionResponse
        BeController -> BeQuestionDto: Create QuestionResponse
        BeQuestionDto --> BeController: QuestionResponse
        BeController --> QuizConfigController: HTTP 201 Created\nCreateSessionResponse
        QuizConfigController --> RetryIncorrectUi: Open quiz session
    end
end

@enduml
