@startuml
title Login Sequence (/api/auth/login)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor Guest
boundary "LoginScreen" as LoginScreen
entity "LoginRequest\n(Request DTO)" as LoginRequest
control "AuthController" as AuthController
control "AuthService" as AuthService
control "BcryptPasswordHasher" as PasswordHasher
control "AuthAccountRepository" as AuthAccountRepository
control "RefreshTokenRepository" as RefreshTokenRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over LoginScreen, MySQL
LoginRequest exists in API Contracts.
end note

Guest -> LoginScreen: Access login page
Guest -> LoginScreen: Enter phone and password
Guest -> LoginScreen: Click Login button
LoginScreen -> LoginScreen: Validate input

alt Data input invalid
    LoginScreen --> Guest: Show error message
else Data input valid
    LoginScreen -> LoginRequest: Create request data\n(phone, password)
    LoginScreen -> AuthController: POST /api/auth/login\nLoginRequest
    AuthController -> AuthController: Validate LoginRequest

    alt Request validation or rate limit fails
        AuthController --> LoginScreen: HTTP 400/429 error
        LoginScreen --> Guest: Show error message
    else Request validation success
        AuthController -> AuthService: LoginAsync(login data)
        AuthService -> AuthAccountRepository: FindByPhoneAsync(phone)
        AuthAccountRepository -> DbContext: Query user by phone
        DbContext -> MySQL: SELECT user account
        MySQL --> DbContext: User row or null
        DbContext --> AuthAccountRepository: Result
        AuthAccountRepository --> AuthService: AuthAccount or null

        alt User not found or password missing
            AuthService --> AuthController: Unauthorized result
            AuthController --> LoginScreen: HTTP 401 Invalid phone or password
            LoginScreen --> Guest: Show error message
        else User found
            AuthService -> PasswordHasher: Verify(password, passwordHash)
            PasswordHasher --> AuthService: Valid or invalid

            alt Password invalid
                AuthService --> AuthController: Unauthorized result
                AuthController --> LoginScreen: HTTP 401 Invalid phone or password
                LoginScreen --> Guest: Show error message
            else Password valid
                alt Account locked or deleted
                    AuthService --> AuthController: Forbidden/Unauthorized result
                    AuthController --> LoginScreen: HTTP 403/401 error
                    LoginScreen --> Guest: Show error message
                else Account active
                    AuthService -> AuthAccountRepository: StageLastLoginAsync(userId)
                    AuthAccountRepository -> DbContext: Update User.LastLoginAt
                    DbContext -> MySQL: UPDATE users
                    MySQL --> DbContext: Update result

                    AuthService -> RefreshTokenRepository: StageCreateAsync(CreateRefreshToken)
                    RefreshTokenRepository -> DbContext: Add RefreshToken
                    DbContext -> MySQL: INSERT refresh_tokens
                    MySQL --> DbContext: Insert result
                    DbContext --> RefreshTokenRepository: Save result
                    RefreshTokenRepository --> AuthService: Login saved

                    AuthService --> AuthController: Return login result
                    AuthController --> LoginScreen: HTTP 200 OK
                    LoginScreen --> Guest: Navigate to app
                end
            end
        end
    end
end

@enduml
