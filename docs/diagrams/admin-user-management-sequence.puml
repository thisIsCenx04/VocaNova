@startuml
title User Management Sequence (/users and /api/admin/users)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor Admin
boundary "Users Page\n(Dashboard)" as UsersPage
control "UsersController\n(Dashboard)" as DashboardUsersController
control "ServiceAPI\n(Dashboard)" as ApiClient
entity "AdminUserQueryRequest /\nAdminUser*Response\n(Request/Response DTO)" as UserManagementDto
control "AdminUsersController\n(API)" as AdminUsersController
control "AdminUserService" as AdminUserService
control "AdminUserRepository" as AdminUserRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over UsersPage, MySQL
Checked in current code:
Dashboard UsersController calls ServiceAPI.
API AdminUsersController uses AdminUserQueryRequest and AdminUser*Response contracts.
Deactivate/Restore return bool in the API envelope, so no separate response DTO is drawn.
end note

Admin -> UsersPage: Open User Management
UsersPage -> DashboardUsersController: GET /users\n(filters, search, paging, sort)
DashboardUsersController -> DashboardUsersController: Normalize filter
DashboardUsersController -> ApiClient: GetUsersAsync(filter)
ApiClient -> UserManagementDto: Create query data\n(page, limit, status,\nsearch, role, sort)
ApiClient -> AdminUsersController: GET /api/admin/users\nAdminUserQueryRequest
AdminUsersController -> AdminUsersController: Validate AdminUserQueryRequest

alt Request validation fails
    AdminUsersController --> ApiClient: HTTP 400 error
    ApiClient --> DashboardUsersController: Error result
    DashboardUsersController --> UsersPage: Show error message
else Request validation success
    AdminUsersController -> AdminUserService: GetUsersAsync(query)
    AdminUserService -> AdminUserRepository: GetUsersAsync(query)
    AdminUserRepository -> DbContext: Query users
    DbContext -> MySQL: SELECT users with role/profile
    MySQL --> DbContext: User rows and total count
    DbContext --> AdminUserRepository: Result
    AdminUserRepository --> AdminUserService: Paged users
    AdminUserService --> AdminUsersController: Return users result
    AdminUsersController -> UserManagementDto: Create response data\n(AdminUserSummaryResponse)
    AdminUsersController --> ApiClient: HTTP 200 OK\nPaged AdminUserSummaryResponse
    ApiClient --> DashboardUsersController: Paged users
    DashboardUsersController --> UsersPage: Render user list
end

alt Admin opens user detail
    Admin -> UsersPage: Select user
    UsersPage -> DashboardUsersController: GET /users/{id}
    DashboardUsersController -> ApiClient: GetUserDetailAsync(id)
    ApiClient -> AdminUsersController: GET /api/admin/users/{id}
    AdminUsersController -> AdminUserService: GetUserDetailAsync(id)
    AdminUserService -> AdminUserRepository: GetUserDetailAsync(id)
    AdminUserRepository -> DbContext: Query user detail
    DbContext -> MySQL: SELECT user profile data
    MySQL --> DbContext: User detail row or null
    DbContext --> AdminUserRepository: Result
    AdminUserRepository --> AdminUserService: User detail or null

    alt User not found
        AdminUserService --> AdminUsersController: NotFound result
        AdminUsersController --> ApiClient: HTTP 404 error
        ApiClient --> DashboardUsersController: null
        DashboardUsersController --> UsersPage: Show not found
    else User found
        AdminUserService --> AdminUsersController: Return detail result
        AdminUsersController -> UserManagementDto: Create response data\n(AdminUserDetailResponse)
        AdminUsersController --> ApiClient: HTTP 200 OK\nAdminUserDetailResponse
        ApiClient --> DashboardUsersController: User detail

        DashboardUsersController -> ApiClient: GetUserTopicsAsync(id)
        ApiClient -> AdminUsersController: GET /api/admin/users/{id}/topics
        AdminUsersController -> AdminUserService: GetUserTopicsAsync(id)
        AdminUserService -> AdminUserRepository: GetUserTopicsAsync(id)
        AdminUserRepository -> DbContext: Query user topics
        DbContext -> MySQL: SELECT selected/suggested topics
        MySQL --> DbContext: Topic rows
        DbContext --> AdminUserRepository: Result
        AdminUserRepository --> AdminUserService: User topics
        AdminUserService --> AdminUsersController: Return topics result
        AdminUsersController -> UserManagementDto: Create response data\n(AdminUserTopicsResponse)
        AdminUsersController --> ApiClient: HTTP 200 OK\nAdminUserTopicsResponse

        DashboardUsersController -> ApiClient: GetUserTestHistoryAsync(id)
        ApiClient -> AdminUsersController: GET /api/admin/users/{id}/test-history
        AdminUsersController -> AdminUserService: GetTestHistoryAsync(id)
        AdminUserService -> AdminUserRepository: GetTestHistoryAsync(id)
        AdminUserRepository -> DbContext: Query test sessions
        DbContext -> MySQL: SELECT test_sessions
        MySQL --> DbContext: Test session rows
        DbContext --> AdminUserRepository: Result
        AdminUserRepository --> AdminUserService: Paged test history
        AdminUserService --> AdminUsersController: Return history result
        AdminUsersController -> UserManagementDto: Create response data\n(AdminUserTestSessionResponse)
        AdminUsersController --> ApiClient: HTTP 200 OK\nPaged AdminUserTestSessionResponse

        ApiClient --> DashboardUsersController: Detail data
        DashboardUsersController --> UsersPage: Render user detail
    end
else Admin changes user status
    Admin -> UsersPage: Click Deactivate/Restore
    UsersPage -> DashboardUsersController: POST /users/{id}/deactivate or restore
    DashboardUsersController -> ApiClient: DeactivateUserAsync(id)\nor RestoreUserAsync(id)
    ApiClient -> AdminUsersController: PATCH /api/admin/users/{id}/deactivate\nor /restore
    AdminUsersController -> AdminUserService: DeactivateAsync(id, actorRole)\nor RestoreAsync(id, actorRole)
    AdminUserService -> AdminUserRepository: GetStatusTargetAsync(id)
    AdminUserRepository -> DbContext: Query target user status
    DbContext -> MySQL: SELECT user status and role
    MySQL --> DbContext: Target row or null
    DbContext --> AdminUserRepository: Result
    AdminUserRepository --> AdminUserService: Status target or null

    alt User not found or cannot be managed
        AdminUserService --> AdminUsersController: NotFound/Forbidden/Conflict result
        AdminUsersController --> ApiClient: HTTP error
        ApiClient --> DashboardUsersController: Action failed
        DashboardUsersController --> UsersPage: Show feedback
    else Status can be changed
        AdminUserService -> AdminUserRepository: StageStatusAsync(id, status)
        AdminUserRepository -> DbContext: Update user status
        DbContext -> MySQL: UPDATE users
        MySQL --> DbContext: Update result

        opt Deactivate user
            AdminUserService -> AdminUserRepository: RevokeActiveRefreshTokensAsync(id)
            AdminUserRepository -> DbContext: Revoke active refresh tokens
            DbContext -> MySQL: UPDATE refresh_tokens
            MySQL --> DbContext: Update result
        end

        AdminUserService -> AdminUserRepository: SaveChangesAsync()
        AdminUserRepository -> DbContext: Save changes
        DbContext --> AdminUserRepository: Save result
        AdminUserRepository --> AdminUserService: Saved
        AdminUserService --> AdminUsersController: Return success result
        AdminUsersController --> ApiClient: HTTP 200 OK
        ApiClient --> DashboardUsersController: Action success
        DashboardUsersController --> UsersPage: Show feedback and refresh page
    end
end

@enduml
