@startuml
title Manage Role Sequence (/roles and /api/superadmin/roles)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor SuperAdmin
boundary "Roles Page\n(Dashboard)" as RolesPage
control "RolesController\n(Dashboard)" as DashboardController
control "ServiceAPI\n(Dashboard)" as ServiceApi
entity "RoleQueryRequest /\nSaveRoleRequest /\nRoleResponse\n(Request/Response DTO)" as RoleDto
control "RolesController\n(API)" as ApiController
control "RoleManagementService" as RoleService
control "RoleManagementRepository" as RoleRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over RolesPage, MySQL
Checked in current code:
Dashboard RolesController calls ServiceAPI for list/create/update/delete.
API uses RoleQueryRequest, SaveRoleRequest, and RoleResponse.
Delete uses route id only and returns bool in the API envelope.
Assign/Remove role also exist in API, but Dashboard calls them from AdminAccountsController role assignment.
end note

SuperAdmin -> RolesPage: Open role management
RolesPage -> DashboardController: GET /roles\n(search, type, sort)
DashboardController -> DashboardController: Normalize filter
DashboardController -> ServiceApi: GetRolesAsync(search, type, sort)
ServiceApi -> RoleDto: Create query data\n(page, limit, search,\ntype, sort)
RoleDto -> ApiController: GET /api/superadmin/roles\nRoleQueryRequest
ApiController -> ApiController: Check super admin authorization
ApiController -> ApiController: Validate RoleQueryRequest

alt Request validation fails
    ApiController --> ServiceApi: HTTP 400 error
    ServiceApi --> DashboardController: Error result
    DashboardController --> RolesPage: Show error message
else Request validation success
    ApiController -> RoleService: GetRolesAsync(query)
    RoleService -> RoleRepository: GetRolesAsync(query)
    RoleRepository -> DbContext: Query roles
    DbContext -> MySQL: SELECT roles
    MySQL --> DbContext: Role rows
    DbContext --> RoleRepository: Result
    RoleRepository --> RoleService: Paged roles
    RoleService --> ApiController: Return roles result
    ApiController -> RoleDto: Create response data\n(RoleResponse)
    RoleDto --> ServiceApi: HTTP 200 OK\nPaged RoleResponse
    ServiceApi --> DashboardController: Paged roles
    DashboardController --> RolesPage: Render role list
end

alt SuperAdmin creates role
    SuperAdmin -> RolesPage: Submit create role form
    RolesPage -> DashboardController: POST /roles/create
    DashboardController -> DashboardController: Validate form input

    alt Form input invalid
        DashboardController --> RolesPage: Show validation message
    else Form input valid
        DashboardController -> ServiceApi: CreateRoleAsync(roleName)
        ServiceApi -> RoleDto: Create request data\n(role_name)
        RoleDto -> ApiController: POST /api/superadmin/roles\nSaveRoleRequest
        ApiController -> ApiController: Validate SaveRoleRequest
        ApiController -> RoleService: CreateAsync(role data)
        RoleService -> RoleService: Normalize and validate role name
        RoleService -> RoleRepository: RoleExistsAsync(roleName)
        RoleRepository -> DbContext: Query role by name
        DbContext -> MySQL: SELECT roles
        MySQL --> DbContext: Role row or null
        DbContext --> RoleRepository: Result
        RoleRepository --> RoleService: exists or not

        alt Role name already exists
            RoleService --> ApiController: Conflict result
            ApiController --> ServiceApi: HTTP 409 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> RolesPage: Show error message
        else Role can be created
            RoleService -> RoleService: Begin transaction
            RoleService -> RoleRepository: AddRoleAsync(roleName)
            RoleRepository -> DbContext: Add Role
            DbContext -> MySQL: INSERT roles
            MySQL --> DbContext: Insert result
            DbContext --> RoleRepository: Save result
            RoleRepository --> RoleService: Created role
            RoleService --> ApiController: Return created role
            ApiController -> RoleDto: Create response data\n(RoleResponse)
            RoleDto --> ServiceApi: HTTP 201 Created\nRoleResponse
            ServiceApi --> DashboardController: Action success
            DashboardController --> RolesPage: Show success and refresh list
        end
    end
else SuperAdmin updates role
    SuperAdmin -> RolesPage: Submit edit role form
    RolesPage -> DashboardController: POST /roles/{roleId}/edit
    DashboardController -> DashboardController: Validate form input

    alt Form input invalid
        DashboardController --> RolesPage: Show validation message
    else Form input valid
        DashboardController -> ServiceApi: UpdateRoleAsync(roleId, roleName)
        ServiceApi -> RoleDto: Create request data\n(role_name)
        RoleDto -> ApiController: PUT /api/superadmin/roles/{roleId}\nSaveRoleRequest
        ApiController -> ApiController: Validate SaveRoleRequest
        ApiController -> RoleService: UpdateAsync(roleId, role data)
        RoleService -> RoleRepository: GetRoleNameAsync(roleId)
        RoleRepository -> DbContext: Query current role name
        DbContext -> MySQL: SELECT roles
        MySQL --> DbContext: Role row or null
        DbContext --> RoleRepository: Result
        RoleRepository --> RoleService: role name or null

        alt Role not found or system role name changed
            RoleService --> ApiController: NotFound/Forbidden result
            ApiController --> ServiceApi: HTTP 404/403 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> RolesPage: Show error message
        else Role can be updated
            RoleService -> RoleRepository: RoleExistsExcludeAsync(roleId, roleName)
            RoleRepository -> DbContext: Query duplicate role name
            DbContext -> MySQL: SELECT roles
            MySQL --> DbContext: Duplicate row or null
            DbContext --> RoleRepository: Result
            RoleRepository --> RoleService: exists or not

            alt Role name already exists
                RoleService --> ApiController: Conflict result
                ApiController --> ServiceApi: HTTP 409 error
                ServiceApi --> DashboardController: Action failed
                DashboardController --> RolesPage: Show error message
            else Role name is available
                RoleService -> RoleService: Begin transaction
                RoleService -> RoleRepository: UpdateRoleAsync(roleId, roleName)
                RoleRepository -> DbContext: Update Role
                DbContext -> MySQL: UPDATE roles
                MySQL --> DbContext: Update result
                DbContext --> RoleRepository: Save result
                RoleRepository --> RoleService: Updated role
                RoleService --> ApiController: Return updated role
                ApiController -> RoleDto: Create response data\n(RoleResponse)
                RoleDto --> ServiceApi: HTTP 200 OK\nRoleResponse
                ServiceApi --> DashboardController: Action success
                DashboardController --> RolesPage: Show success and refresh list
            end
        end
    end
else SuperAdmin deletes role
    SuperAdmin -> RolesPage: Click Delete role
    RolesPage -> DashboardController: POST /roles/{roleId}/delete
    DashboardController -> ServiceApi: DeleteRoleAsync(roleId)
    ServiceApi -> ApiController: DELETE /api/superadmin/roles/{roleId}
    ApiController -> ApiController: Check super admin authorization
    ApiController -> RoleService: DeleteAsync(roleId)
    RoleService -> RoleRepository: GetRoleNameAsync(roleId)
    RoleRepository -> DbContext: Query role name
    DbContext -> MySQL: SELECT roles
    MySQL --> DbContext: Role row or null
    DbContext --> RoleRepository: Result
    RoleRepository --> RoleService: role name or null

    alt Role not found or system role
        RoleService --> ApiController: NotFound/Forbidden result
        ApiController --> ServiceApi: HTTP 404/403 error
        ServiceApi --> DashboardController: Action failed
        DashboardController --> RolesPage: Show error message
    else Role exists and is custom
        RoleService -> RoleRepository: HasUsersWithRoleAsync(roleId)
        RoleRepository -> DbContext: Check users with role
        DbContext -> MySQL: SELECT users
        MySQL --> DbContext: User row or null
        DbContext --> RoleRepository: Result
        RoleRepository --> RoleService: has users or not

        alt Role still assigned to users
            RoleService --> ApiController: Conflict result
            ApiController --> ServiceApi: HTTP 409 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> RolesPage: Show error message
        else Role can be deleted
            RoleService -> RoleService: Begin transaction
            RoleService -> RoleRepository: DeleteRoleAsync(roleId)
            RoleRepository -> DbContext: Remove Role
            DbContext -> MySQL: DELETE roles
            MySQL --> DbContext: Delete result
            DbContext --> RoleRepository: Save result
            RoleRepository --> RoleService: Deleted
            RoleService --> ApiController: Success result
            ApiController --> ServiceApi: HTTP 200 OK
            ServiceApi --> DashboardController: Action success
            DashboardController --> RolesPage: Show success and refresh list
        end
    end
end

@enduml
