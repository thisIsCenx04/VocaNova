@startuml
title Assign Role To User Sequence (/api/superadmin/roles/{roleId}/users/{userId})

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor SuperAdmin
boundary "Role Assignment\nPage (Dashboard)" as RoleAssignmentPage
control "AdminAccountsController\n(Dashboard)" as DashboardController
control "ServiceAPI\n(Dashboard)" as ServiceApi
control "AdminUsersController\n(API)" as AdminUsersController
control "RolesController\n(API)" as ApiController
control "RoleManagementService" as RoleService
control "RoleManagementRepository" as RoleRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over RoleAssignmentPage, MySQL
Checked in current code:
Dashboard AdminAccountsController handles role assignment.
ServiceAPI calls POST /api/superadmin/roles/{roleId}/users/{userId}.
No request DTO body is used; API returns bool in the response envelope.
Assigning a role revokes active refresh tokens for the user.
end note

SuperAdmin -> RoleAssignmentPage: Open role assignment page
RoleAssignmentPage -> DashboardController: GET /admin-accounts/role-assignment\n(search, role, page)
DashboardController -> ServiceApi: GetUsersAsync(filter)
ServiceApi -> AdminUsersController: GET /api/admin/users\n(role filter)
AdminUsersController --> ServiceApi: Paged users
ServiceApi --> DashboardController: Users
DashboardController --> RoleAssignmentPage: Render assignable users

SuperAdmin -> RoleAssignmentPage: Select target role
RoleAssignmentPage -> DashboardController: POST /admin-accounts/{id}/role
DashboardController -> DashboardController: Validate role value\n(user or admin)

alt Role input invalid
    DashboardController --> RoleAssignmentPage: Show error message
else Role input valid
    DashboardController -> ServiceApi: GetRolesAsync()
    ServiceApi -> ApiController: GET /api/superadmin/roles
    ApiController -> RoleService: GetRolesAsync(query)
    RoleService -> RoleRepository: GetRolesAsync(query)
    RoleRepository -> DbContext: Query roles
    DbContext -> MySQL: SELECT roles
    MySQL --> DbContext: Role rows
    DbContext --> RoleRepository: Result
    RoleRepository --> RoleService: Paged roles
    RoleService --> ApiController: Return roles result
    ApiController --> ServiceApi: HTTP 200 OK
    ServiceApi --> DashboardController: Roles

    alt Target role not found
        DashboardController --> RoleAssignmentPage: Show error message
    else Target role found
        DashboardController -> ServiceApi: AssignRoleAsync(roleId, userId)
        ServiceApi -> ApiController: POST /api/superadmin/roles/{roleId}/users/{userId}
        ApiController -> ApiController: Check super admin authorization
        ApiController -> RoleService: AssignRoleAsync(roleId, userId)

        RoleService -> RoleRepository: GetRoleNameAsync(roleId)
        RoleRepository -> DbContext: Query target role
        DbContext -> MySQL: SELECT roles
        MySQL --> DbContext: Role row or null
        DbContext --> RoleRepository: Result
        RoleRepository --> RoleService: role name or null

        RoleService -> RoleRepository: GetUserRoleNameAsync(userId)
        RoleRepository -> DbContext: Query current user role
        DbContext -> MySQL: SELECT user with role
        MySQL --> DbContext: User row or null
        DbContext --> RoleRepository: Result
        RoleRepository --> RoleService: user role name or null

        alt Role/user not found or protected role
            RoleService --> ApiController: NotFound/Forbidden result
            ApiController --> ServiceApi: HTTP 404/403 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> RoleAssignmentPage: Show error message
        else User already has this role
            RoleService -> RoleRepository: GetRoleIdByNameAsync(currentRole)
            RoleRepository -> DbContext: Query current role id
            DbContext -> MySQL: SELECT roles
            MySQL --> DbContext: Role id
            DbContext --> RoleRepository: Result
            RoleRepository --> RoleService: current role id
            RoleService --> ApiController: Conflict result
            ApiController --> ServiceApi: HTTP 409 error
            ServiceApi --> DashboardController: Action failed
            DashboardController --> RoleAssignmentPage: Show error message
        else Role can be assigned
            RoleService -> RoleRepository: GetRoleIdByNameAsync(currentRole)
            RoleRepository -> DbContext: Query current role id
            DbContext -> MySQL: SELECT roles
            MySQL --> DbContext: Role id
            DbContext --> RoleRepository: Result
            RoleRepository --> RoleService: current role id

            RoleService -> RoleService: Begin transaction
            RoleService -> RoleRepository: AssignRoleAsync(roleId, userId)
            RoleRepository -> DbContext: Update user role
            DbContext -> MySQL: UPDATE users
            MySQL --> DbContext: Update result

            RoleService -> RoleRepository: RevokeActiveRefreshTokensAsync(userId)
            RoleRepository -> DbContext: Revoke active refresh tokens
            DbContext -> MySQL: UPDATE refresh_tokens
            MySQL --> DbContext: Update result
            DbContext --> RoleRepository: Save result
            RoleRepository --> RoleService: Saved

            RoleService --> ApiController: Success result
            ApiController --> ServiceApi: HTTP 200 OK
            ServiceApi --> DashboardController: Action success
            DashboardController --> RoleAssignmentPage: Show feedback and refresh page
        end
    end
end

@enduml
