@startuml
title Update Display Name Sequence (/api/auth/me/profile)

autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

actor Learner
boundary "Update Display Name UI" as DisplayNameUi
control "AuthNotifier\n(FE Mobile)" as FeController
control "AuthApiService\n(FE Mobile)" as FeApiService
entity "UserProfileDto\n(FE Response DTO)" as FeProfileDto
entity "UpdateUserProfileRequest\n(BE Request DTO)" as BeUpdateProfileDto
entity "UserProfileResponse\n(BE Response DTO)" as BeProfileDto
control "AuthController\n(BE API)" as BeController
control "AuthService" as AuthService
entity "User" as UserEntity
entity "UserProfile" as UserProfileEntity
control "AuthAccountRepository" as AccountRepository
control "IAuthAccountRepository" as IAuthAccountRepository
database "VocaNovaDbContext" as DbContext
database "MySQL Database" as MySQL

note over DisplayNameUi, MySQL
Checked in current code:
Mobile UI file exists: profile_screen.dart.
FE controller/service exist: AuthNotifier and AuthApiService.
FE response DTO exists: UserProfileDto.
BE DTOs exist: UpdateUserProfileRequest and UserProfileResponse.
Endpoint is PUT /api/auth/me/profile.
Entities exist: User and UserProfile.
Interfaces used in code: IAuthAccountRepository.
end note

Learner -> DisplayNameUi: Enter new display name
Learner -> DisplayNameUi: Save changes
DisplayNameUi -> FeController: updateProfile(displayName, avatarUrl?)
FeController -> FeApiService: updateProfile(displayName, avatarUrl?)
FeApiService -> BeController: PUT /api/auth/me/profile\nJSON body
BeController -> BeUpdateProfileDto: Bind request body
BeUpdateProfileDto --> BeController: UpdateUserProfileRequest
BeController -> BeController: Check authenticated user
BeController -> BeController: Validate UpdateUserProfileRequest

alt Request invalid
    BeController --> FeApiService: HTTP 400 error
    FeApiService --> FeController: Action failed
    FeController --> DisplayNameUi: Show update error
else Request valid
    BeController -> AuthService: UpdateProfileAsync(userId, command)
    AuthService -> IAuthAccountRepository: UpdateProfileAsync(userId, command)
    IAuthAccountRepository -> AccountRepository: UpdateProfileAsync(userId, command)
    AccountRepository -> DbContext: Find user aggregate
    DbContext -> MySQL: SELECT users\nLEFT JOIN user_profiles
    MySQL --> DbContext: User rows or null

    alt User not found or deleted
        DbContext --> AccountRepository: null
        AccountRepository --> AuthService: null
        AuthService --> BeController: NotFound result
        BeController --> FeApiService: HTTP 404 error
        FeApiService --> FeController: Action failed
        FeController --> DisplayNameUi: Show update error
    else User found
        DbContext -> UserEntity: Read User
        DbContext -> UserProfileEntity: Read UserProfile
        UserEntity --> DbContext: User
        UserProfileEntity --> DbContext: UserProfile
        AccountRepository -> UserProfileEntity: Set FullName\nand AvatarUrl?
        AccountRepository -> UserEntity: Set UpdatedAt
        UserProfileEntity --> AccountRepository: UserProfile updated
        UserEntity --> AccountRepository: User updated
        AccountRepository -> DbContext: Track profile update
        DbContext -> MySQL: UPDATE user_profiles,\nUPDATE users
        MySQL --> DbContext: Update result
        DbContext --> AccountRepository: Updated profile
        AccountRepository --> AuthService: User profile
        AuthService --> BeController: Profile result
        BeController -> BeProfileDto: Create UserProfileResponse
        BeProfileDto --> BeController: UserProfileResponse
        BeController --> FeApiService: HTTP 200 OK\nUserProfileResponse
        FeApiService -> FeProfileDto: Parse response data
        FeProfileDto --> FeApiService: UserProfile
        FeApiService --> FeController: UserProfile
        FeController --> DisplayNameUi: Show update success
    end
end

@enduml
